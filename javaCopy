package com.epay.admin.portal.validator;

import com.epay.admin.portal.entity.admin.master.MasterBulkUploadConfig;
import com.epay.admin.portal.exceptions.AdminPortalException;
import com.epay.admin.portal.service.master.MasterBulkUploadService;
import com.epay.admin.portal.util.ErrorConstants;
import lombok.RequiredArgsConstructor;
import org.apache.commons.lang3.StringUtils;
import org.springframework.stereotype.Component;
import org.springframework.web.multipart.MultipartFile;

@Component
@RequiredArgsConstructor
public class MasterBulkUploadValidation extends BaseValidator{
    private final MasterBulkUploadService masterBulkUploadService;

    public void validateFile(MultipartFile file, MasterBulkUploadConfig config,String checksum) {
        if (file == null || file.isEmpty()) {
            throw new AdminPortalException(ErrorConstants.MANDATORY_ERROR_CODE, "Bulk upload file is required.");
        }
        String fileName = file.getOriginalFilename();
        if (StringUtils.isBlank(fileName) || !fileName.toLowerCase().endsWith(".csv")) {
            throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, "Only csv file format is allowed.");
        }

        if (!config.isBulkUploadAllowed()) {
            throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, "Bulk upload is not enabled for " + config.getMasterType());
        }

        if(masterBulkUploadService.existsByFileChecksum(checksum)){
            throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, "Duplicate file content already uploaded for  masterType "+ config.getMasterType());
        }


    }

}

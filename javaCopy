        Specification<CountryCurrency> specification = MasterSpecification.buildCountryCurrency(request.getFilters());
        return countryCurrencyDao.findBySpecification(specification, pageable);
    }

    @Override
    @Transactional
    public BulkUploadProcessResult process(List<BulkUploadRecordContext> contexts) {
        List<BulkUploadRowResult> rowResults = new ArrayList<>(java.util.Collections.nCopies(contexts.size(), null));
        List<MasterWorkFlowDto> workflowDtos = new ArrayList<>();
        List<CreateMaster> createMasters = new ArrayList<>();
        List<InactivateMaster> inactivateMasters = new ArrayList<>();

        for (int index = 0; index < contexts.size(); index++) {
            BulkUploadRecordContext context = contexts.get(index);
            CountryCurrencyDto dto = objectMapper.convertValue(context.getRecord(), CountryCurrencyDto.class);
            String status = context.getRecord().get(STATUS);

            try {
                if (StringUtils.isBlank(status) || ACTIVE.equalsIgnoreCase(status)) {
                    validate(dto, WorkflowOperation.CREATE);
                    if (findExact(dto).isPresent()) {
                        rowResults.set(index, failure(RECORD_ALREADY_EXISTS));
                    } else {
                        createMasters.add(new CreateMaster(index, dto));
                    }
                    continue;
                }

                if (INACTIVE.equalsIgnoreCase(status)) {
                    Optional<CountryCurrencyDto> activeRecord = countryCurrencyDao.findCountryCurrencyDtls(dto);
                    if (activeRecord.isPresent()) {
                        inactivateMasters.add(new InactivateMaster(index, activeRecord.get()));
                        continue;
                    }
                    rowResults.set(index, failure(NO_VALID_RECORDS));
                    continue;
                }

                rowResults.set(index, failure("Unsupported status value: " + context.getRecord().get(STATUS)));
            } catch (AdminPortalException ex) {
                rowResults.set(index, failure(ex.getMessage()));
            }
        }
        persistCreates(createMasters, rowResults, workflowDtos);
        persistInactivation(inactivateMasters, rowResults, workflowDtos);
        return BulkUploadProcessResult.builder().rowResults(rowResults).workflowDtos(workflowDtos).build();
    }

    private Optional<CountryCurrency> findExact(CountryCurrencyDto dto) {
        return countryCurrencyDao.findCountryCurrency(dto);
    }

    private void persistCreates(List<CreateMaster> createMasters, List<BulkUploadRowResult> rowResults, List<MasterWorkFlowDto> workflowDtos) {
        if(createMasters.isEmpty()){
            return;
        }
        List<CountryCurrencyDto> dtos = createMasters.stream().map(CreateMaster::dto).toList();
        List<CountryCurrencyDto> savedDtos = countryCurrencyDao.create(dtos);
        for (int i = 0; i < createMasters.size(); i++) {
            CreateMaster createMaster = createMasters.get(i);
            CountryCurrencyDto savedDto = savedDtos.get(i);
            workflowDtos.add(mapToMasterWorkFlowDto(savedDto, WorkflowOperation.CREATE, MessageFormat.format("Bulk upload {0} action performed.", WorkflowOperation.CREATE.name())));
            rowResults.set(createMaster.index(), BulkUploadRowResult.builder().recordStatus(BulkUploadRecordStatus.SUCCESS.name()).operation(WorkflowOperation.CREATE.name()).remark(CREATE_PENDING_REMARK).masterRecordId(savedDto.getId()).build());
            }
    }

    private void persistInactivation(List<InactivateMaster> pendingInactivation, List<BulkUploadRowResult> rowResults, List<MasterWorkFlowDto> workflowDtos) {
        if (pendingInactivation.isEmpty()) {
            return;
        }
        List<UUID> ids = pendingInactivation.stream().map(pendingInactivate -> pendingInactivate.record().getId()).toList();
        performAction(ids, WorkflowOperation.INACTIVE);
        for (InactivateMaster pendingInactivate : pendingInactivation) {
            CountryCurrencyDto record = pendingInactivate.record();
            workflowDtos.add(mapToMasterWorkFlowDto(record, WorkflowOperation.INACTIVE, MessageFormat.format("Bulk upload {0} action performed.", WorkflowOperation.INACTIVE.name())));
            rowResults.set(pendingInactivate.index(), BulkUploadRowResult.builder().recordStatus(BulkUploadRecordStatus.SUCCESS.name()).operation(WorkflowOperation.INACTIVE.name()).remark(INACTIVE_PENDING_REMARK).masterRecordId(record.getId()).build());
        }
    }


    private BulkUploadRowResult failure(String remark) {
        return BulkUploadRowResult.builder()
                .recordStatus(BulkUploadRecordStatus.FAILED.name())
                .remark(remark)
                .build();
    }

    @Override
    public AdminPortalResponse<Map<String, Object>> mapToResponse(List<CountryCurrencyDto> dtos, Long total) {
        List<Map<String, Object>> masterResponse = dtos.stream().<Map<String, Object>>map(countryCurrencyDto -> objectMapper.convertValue(countryCurrencyDto, new TypeReference<>() {
        })).collect(Collectors.toList());
        return AdminPortalResponse.<Map<String, Object>>builder().status(SUCCESS_RESPONSE_CODE).data(masterResponse).count((long) dtos.size()).total(total).build();
    }

@MapperConfig(componentModel = "spring", builder = @Builder(disableBuilder = true))
public interface MasterMapper<T extends BaseMasterDto, E extends BaseMasterEntity> {

    T mapEntityToDto(E entity);

    List<T> mapEntityToDto(List<E> entities);

    E mapDtoToEntity(T dto);

    List<E> mapDtoToEntity(List<T> dtos);

    @BeanMapping(nullValuePropertyMappingStrategy = NullValuePropertyMappingStrategy.IGNORE)
    void updateEntityByDto(T dto, @MappingTarget E entity);
}


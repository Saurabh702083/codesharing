package com.epay.admin.portal.repository.admin.master;

import com.epay.admin.portal.entity.admin.master.CountryCurrency;
import jakarta.transaction.Transactional;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.JpaSpecificationExecutor;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import java.util.List;
import java.util.Optional;
import java.util.UUID;
/**
 * Class Name: CountryCurrencyRepository
 * *
 * Author: V1018841(Saurabh Mahto)
 * <p>
 * Copyright (c) 2026 [State Bank of India]
 * All rights reserved
 * *
 * Version:1.0
 */
public interface CountryCurrencyRepository extends JpaRepository<CountryCurrency, UUID> , JpaSpecificationExecutor<CountryCurrency> {

    @Transactional
    @Modifying
    @Query("""
           UPDATE CountryCurrency c SET c.action = :action,
            c.status = CASE
                WHEN c.action='PENDING_FOR_APPROVAL' THEN 'ACTIVE'
                WHEN c.action='PENDING_FOR_REJECTED' THEN 'INACTIVE'
                WHEN c.action='PENDING_FOR_INACTIVE' THEN 'INACTIVE'
                ELSE 'INACTIVE'
            END
            WHERE c.id IN :ids
           """)
    int approve(@Param("ids") List<UUID> ids, String action);


    @Transactional
    @Modifying
    @Query("""
           UPDATE CountryCurrency c SET c.action = :action WHERE c.id IN :ids
           """)
    int performAction(@Param("ids") List<UUID> ids, String action);

    Optional<CountryCurrency> findByCodeAndNameAndCurrencyCodeAndCurrencyName(
            String code, String name, String currencyCode, String currencyName);

    Optional<CountryCurrency> findByCodeAndNameAndCurrencyCodeAndCurrencyNameAndStatusAndAction(
            String code, String name, String currencyCode, String currencyName, String status, String action);
}

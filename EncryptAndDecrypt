@Component
public class UserSearchValidator {

    private static final Set<String> ALLOWED_AUTH_STATUSES = Set.of(
            "ALL",
            "APPROVED",
            "PENDING",
            "PENDING_FOR_AUTHORIZATION",
            "REJECTED"
    );

    public void validate(
            UserSearchTarget target,
            UserSearchRequest request
    ) {

        if (target == null) {
            throw new AdminPortalException(
                    "USR_011",
                    "Search target is mandatory"
            );
        }

        if (request == null) {
            throw new AdminPortalException(
                    "USR_012",
                    "Search request is mandatory"
            );
        }

        if (StringUtils.hasText(request.getAuthStatus())
                && !ALLOWED_AUTH_STATUSES.contains(
                        request.getAuthStatus().trim().toUpperCase()
                )) {
            throw new AdminPortalException(
                    "USR_013",
                    "Invalid authorization status"
            );
        }

        if (request.getFromDate() != null
                && request.getToDate() != null
                && request.getFromDate().isAfter(request.getToDate())) {
            throw new AdminPortalException(
                    "USR_014",
                    "From date cannot be greater than to date"
            );
        }

        validateLength(request.getAdId(), 100, "AD ID");
        validateLength(request.getFirstName(), 100, "First name");
        validateLength(request.getLastName(), 100, "Last name");
        validateLength(request.getEmailId(), 150, "Email");
        validateLength(request.getPhoneNumber(), 20, "Phone number");
        validateLength(request.getRoleCode(), 100, "Role code");
        validateLength(request.getRoleName(), 150, "Role name");
        validateLength(request.getGroupName(), 150, "Group name");
    }

    private void validateLength(
            String value,
            int maxLength,
            String fieldName
    ) {

        if (StringUtils.hasText(value)
                && value.trim().length() > maxLength) {
            throw new AdminPortalException(
                    "USR_015",
                    fieldName + " cannot exceed " + maxLength + " characters"
            );
        }
    }
}


@Service
@RequiredArgsConstructor
public class UserSearchService {

    private final AdminUserSearchRepository adminUserSearchRepository;
    private final UserSearchScopeService userSearchScopeService;
    private final UserSearchValidator userSearchValidator;

    public AdminPortalResponse<UserSearchResponse> searchUsers(
            UserSearchTarget target,
            UserSearchRequest request,
            Pageable pageable
    ) {

        userSearchValidator.validate(target, request);
        validateSort(pageable);

        String loggedInAdId = EPayIdentityUtil
                .getUserPrincipal()
                .getUserName();

        if (!StringUtils.hasText(loggedInAdId)) {
            throw new AdminPortalException(
                    "USR_016",
                    "Unable to identify logged-in user"
            );
        }

        // Resolve logged-in user's actual access scope.
        UserSearchScope scope = userSearchScopeService.resolveScope(
                target,
                request.getBusinessGroupId(),
                loggedInAdId
        );

        // Build all filters in one Specification class.
        Specification<AdminUserSearchView> specification =
                AdminUserSearchSpecification.buildSpecification(
                        target,
                        request,
                        scope
                );

        Page<AdminUserSearchView> resultPage =
                adminUserSearchRepository.findAll(
                        specification,
                        pageable
                );

        List<UserSearchResponse> responseData =
                resultPage.getContent()
                        .stream()
                        .map(this::mapToResponse)
                        .toList();

        return AdminPortalResponse.<UserSearchResponse>builder()
                .status(HttpStatus.OK.value())
                .data(responseData)
                .count((long) responseData.size())
                .total(resultPage.getTotalElements())
                .build();
    }

    private UserSearchResponse mapToResponse(AdminUserSearchView view) {

        return UserSearchResponse.builder()
                .userId(view.getUserId())
                .userRoleId(view.getUserRoleId())

                .adId(view.getAdId())
                .firstName(view.getFirstName())
                .lastName(view.getLastName())
                .emailId(view.getEmailId())
                .phoneNumber(view.getPhoneNumber())

                .userStatus(view.getUserStatus())
                .userType(view.getUserType())

                .designation(view.getDesignation())
                .officeAddress(view.getOfficeAddress())

                .roleCode(view.getRoleCode())
                .roleName(view.getRoleName())
                .roleActive(view.getRoleActive())
                .roleAuthStatus(view.getRoleAuthStatus())
                .roleRecordStatus(view.getRoleRecordStatus())

                .groupName(view.getGroupName())
                .groupCode(view.getGroupCode())
                .businessGroupId(view.getBusinessGroupId())

                .createdAt(view.getCreatedAt())
                .build();
    }

    private void validateSort(Pageable pageable) {

        Set<String> allowedSortFields = Set.of(
                "createdAt",
                "adId",
                "firstName",
                "lastName",
                "emailId",
                "roleName",
                "groupName",
                "userStatus"
        );

        for (Sort.Order order : pageable.getSort()) {

            if (!allowedSortFields.contains(order.getProperty())) {
                throw new AdminPortalException(
                        "USR_017",
                        "Unsupported sort field: " + order.getProperty()
                );
            }
        }
    }
}


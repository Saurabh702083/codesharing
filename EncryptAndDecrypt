                .and(hasTo(request.getTo()));

        if(!StringUtils.isEmpty(userId)) {
            String uuIdUserId = userId.replace("-", "").toUpperCase();
            if(!StringUtils.isEmpty(actionType)) {
                searchedMIF = searchedMIF.and(hasJourneyInfo(stage, request.getStatus(), uuIdUserId, actionType));
            } else {
                searchedMIF = searchedMIF.and(hasJourneyInfo(stage, request.getStatus(), uuIdUserId, null));
            }
        } else {
            searchedMIF = searchedMIF.and(hasJourneyInfo(StringUtils.isEmpty(stage) ? request.getStage() : stage, request.getStatus(), null, null));
        }

        return searchedMIF;
    }

    public static Specification<MvJourney> hasMifId(String mifId) {
        return (root, query, cb) ->
                StringUtils.isEmpty(mifId) ? cb.conjunction()
                        : cb.like(cb.lower(root.get("merchantMifId")), String.format(LIKE_ALL_STRING_FORMATTER, mifId));
    }

    public static Specification<MvJourney> hasLegalName(String legalName) {
        return (root, query, cb) ->
                StringUtils.isEmpty(legalName) ? cb.conjunction()
                        : cb.like(cb.lower(root.get("legalName")), String.format(LIKE_ALL_STRING_FORMATTER, legalName.toLowerCase()));
    }

    public static Specification<MvJourney> hasBrandName(String brandName) {
        return (root, query, cb) ->
                StringUtils.isEmpty(brandName) ? cb.conjunction()
                        : cb.like(cb.lower(root.get("brandName")), String.format(LIKE_ALL_STRING_FORMATTER, brandName.toLowerCase()));
    }

    public static Specification<MvJourney> hasFrom(Long from) {
        return (root, query, cb) ->
                from == null ? cb.conjunction()
                        : cb.ge(root.get("mifSubmissionDate"), from);
    }

    public static Specification<MvJourney> hasTo(Long to) {
        return (root, query, cb) ->
                to == null ? cb.conjunction()
                        : cb.le(root.get("mifSubmissionDate"), to);
    }

    public static Specification<MvJourney> hasJourneyInfo(String stage, String status, String userId, String actionType) {
        return (root, query, cb) -> {
            if (StringUtils.isEmpty(userId) && StringUtils.isEmpty(actionType) && StringUtils.isEmpty(stage) && StringUtils.isEmpty(status)) {
                return cb.conjunction();
            }

            String matchPattern = String.format("@.%s == \"%s\"", "journeyType", "ONBOARDING");

            if(!StringUtils.isEmpty(stage)) {
                matchPattern += " && " + String.format("@.%s == \"%s\"", "stageCode", stage);
            }
            if(!StringUtils.isEmpty(status)) {
                matchPattern += " && " + String.format("@.%s == \"%s\"", "status", status);
            }
            if (!StringUtils.isEmpty(userId)) {
                if(!StringUtils.isEmpty(actionType)) {
                    matchPattern += " && exists(" + String.format("@.assignedUserDetails[*]?(@.%s == \"%s\" && @.%s == \"%s\"))", "userId", userId, "actionType", actionType);
                } else {
                    matchPattern += " && exists(" + String.format("@.assignedUserDetails[*]?(@.%s == \"%s\"))", "userId", userId);
                }
            }

            String jsonPath = String.format("$[*]?(%s)", matchPattern);
            return cb.isTrue(
                cb.function("JSON_EXISTS", Boolean.class,
                        root.get("journeyInfo"),
                        cb.literal(jsonPath)
                )
            );
        };
    }
}



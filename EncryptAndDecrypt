CREATE OR REPLACE VIEW VW_ADMIN_USER_SEARCH AS
SELECT
    /* User details */
    U.ID                    AS USER_ID,
    U.AGGREGATOR_ID         AS AGGREGATOR_ID,
    U.AD_ID                 AS AD_ID,
    U.FIRST_NAME            AS FIRST_NAME,
    U.LAST_NAME             AS LAST_NAME,
    U.EMAIL_ID              AS EMAIL_ID,
    U.PHONE_NUMBER          AS PHONE_NUMBER,
    U.STATUS                AS USER_STATUS,
    U.USER_TYPE             AS USER_TYPE,
    U.DESIGNATION           AS DESIGNATION,
    U.OFFICE_ADDRESS        AS OFFICE_ADDRESS,
    U.RECORD_STATUS         AS USER_RECORD_STATUS,

    /* User role details */
    UR.ID                   AS USER_ROLE_ID,
    UR.IS_PRIMARY           AS IS_PRIMARY,
    UR.IS_ACTIVE            AS ROLE_ACTIVE,
    UR.AUTH_STATUS          AS ROLE_AUTH_STATUS,
    UR.RECORD_STATUS        AS ROLE_RECORD_STATUS,
    UR.FROM_DATE            AS ROLE_FROM_DATE,
    UR.TO_DATE              AS ROLE_TO_DATE,
    UR.CREATED_AT           AS CREATED_AT,

    /* Business role details */
    BRM.ID                  AS ROLE_ID,
    BRM.BR_CODE             AS ROLE_CODE,
    BRM.NAME                AS ROLE_NAME,
    BRM.TYPE                AS ROLE_TYPE,
    BRM.USER_TYPE           AS ROLE_USER_TYPE,
    BRM.BUSINESS_GROUP_ID   AS BUSINESS_GROUP_ID,

    /* Business group details */
    BGM.NAME                AS GROUP_NAME,
    BGM.BG_CODE             AS GROUP_CODE

FROM USERS U

INNER JOIN USER_ROLE UR
    ON UR.USER_ID = U.ID

INNER JOIN BUSINESS_ROLES_MASTER BRM
    ON BRM.ID = UR.ROLE_ID

LEFT JOIN BUSINESS_GROUP_MASTER BGM
    ON BGM.ID = BRM.BUSINESS_GROUP_ID

WHERE
    UR.IS_PRIMARY = 1
    AND UR.DELETED_AT IS NULL
    AND U.DELETED_AT IS NULL;




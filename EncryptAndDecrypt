@RestController
@RequestMapping("/admin/users")
@RequiredArgsConstructor
@Slf4j
public class UserSearchController {

    private final UserSearchService userSearchService;


    @PreAuthorize("hasAnyRole(" +
            "'MASTER_ADMIN'," +
            "'SUPER_ADMIN'," +
            "'BIZ_GROUP_ADMIN'," +
            "'BANK_IT_GROUP_ADMIN'," +
            "'OPS_ITDCR_GROUP_ADMIN'," +
            "'CMD_GROUP_ADMIN')")
    @PostMapping("/search")
    @Operation(
            summary = "Search Admin Users",
            description = "Fetch admin users based on role hierarchy and filters"
    )
    public AdminPortalResponse<UserSearchResponse> searchUsers(

            @Valid @RequestBody UserSearchRequest request,

            @PageableDefault(
                    size = 50,
                    sort = "createdAt",
                    direction = Sort.Direction.DESC
            ) Pageable pageable) {


        log.debug(
                "Received user search request for view: {}",
                request.getViewType()
        );


        return userSearchService.searchUsers(
                request,
                pageable
        );
    }

}




@Service
@RequiredArgsConstructor
@Slf4j
public class UserSearchService {

    private final UserSearchValidator userSearchValidator;

    private final UserSearchDao userSearchDao;


    @Transactional(readOnly = true)
    public AdminPortalResponse<UserSearchResponse> searchUsers(
            UserSearchRequest request,
            Pageable pageable) {

        log.debug(
                "User search started for view: {}",
                request.getViewType()
        );


        // 1. Validate request and logged-in user's permissions

        UserSearchCriteria criteria =
                userSearchValidator.validateAndBuildCriteria(request);


        // 2. Fetch users through DAO

        Page<UserSearchResponse> result =
                userSearchDao.searchUsers(criteria, pageable);


        // 3. Build common response

        log.debug(
                "User search completed. Total records: {}",
                result.getTotalElements()
        );


        return AdminPortalResponse.<UserSearchResponse>builder()

                .status(HttpStatus.OK.value())

                .data(result.getContent())

                .count((long) result.getNumberOfElements())

                .total(result.getTotalElements())

                .build();
    }

}




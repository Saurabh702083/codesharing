
/**
 * Class Name: CountryCurrencyDao
 * <p>
 * Data access layer for {@link CountryCurrency} master records. Handles
 * persistence operations (create, update, bulk create, search, and
 * workflow-action updates) and delegates entity/DTO conversion to
 * {@link MasterMapper}.
 * <p>
 * Author: V1018841(Saurabh Mahto)
 * <p>
 * Copyright (c) 2026 [State Bank of India]
 * All rights reserved
 * <p>
 * Version:1.0
 */
@Component
@RequiredArgsConstructor
public class CountryCurrencyDao {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MasterMapper<CountryCurrencyDto, CountryCurrency> masterMapper;
    private final CountryCurrencyRepository countryCurrencyRepository;

    /**
     * Persists a new CountryCurrency record.
     *
     * @param countryCurrencyDto the DTO containing the record to be created
     * @return the persisted record mapped back to DTO, including generated fields (e.g. id)
     */
    public CountryCurrencyDto create(CountryCurrencyDto countryCurrencyDto) {
        logger.info("Creating CountryCurrency record: {}", countryCurrencyDto);
        CountryCurrency entity = countryCurrencyRepository.save(masterMapper.mapDtoToEntity(countryCurrencyDto));
        logger.info("CountryCurrency record created successfully with id: {}", entity.getId());
        return masterMapper.mapEntityToDto(entity);
    }

    /**
     * Updates an existing CountryCurrency record identified by the DTO's id.
     *
     * @param dto the DTO containing the updated field values, must include a valid id
     * @return the updated record mapped back to DTO
     * @throws AdminPortalException if no record is found for the given id
     */
    public CountryCurrencyDto update(CountryCurrencyDto dto) {
        logger.info("Updating CountryCurrency record with id: {}", dto.getId());
        CountryCurrency entity = countryCurrencyRepository.findById(dto.getId())
                .orElseThrow(() -> {
                    logger.error("CountryCurrency record not found for id: {}", dto.getId());
                    return new AdminPortalException(FAILED_ERROR_CODE, MessageFormat.format(FAILED_ERROR_MESSAGE_WITH_REASON, "CountryCurrency update", "CountryCurrency record not found for the masterId"));
                });
        masterMapper.updateEntityByDto(dto, entity);
        CountryCurrency updatedCountryCurrency = countryCurrencyRepository.save(entity);
        logger.info("CountryCurrency record updated successfully for id: {}", dto.getId());
        return masterMapper.mapEntityToDto(updatedCountryCurrency);
    }

    /**
     * Fetches multiple CountryCurrency records by their ids.
     *
     * @param ids the list of record ids to fetch
     * @return list of matching records mapped to DTO; ids with no match are silently skipped
     */
    public List<CountryCurrencyDto> findAllById(List<UUID> ids) {
        logger.info("Fetching CountryCurrency records for ids: {}", ids);
        List<CountryCurrencyDto> result = countryCurrencyRepository.findAllById(ids).stream().map(masterMapper::mapEntityToDto).toList();
        logger.info("Fetched {} CountryCurrency record(s) for {} requested id(s)", result.size(), ids.size());
        return result;
    }

    /**
     * Bulk-persists CountryCurrency records, typically used during CSV bulk upload.
     * Each record is set to status INACTIVE and action PENDING_FOR_APPROVAL before saving.
     *
     * @param dtos the list of DTOs to be created
     * @return the persisted records mapped back to DTOs
     */
    public List<CountryCurrencyDto> create(List<CountryCurrencyDto> dtos) {
        logger.info("Bulk creating {} CountryCurrency record(s)", dtos.size());
        dtos.forEach(dto -> {
            dto.setStatus(MasterAction.INACTIVE.name());
            dto.setAction(MasterAction.PENDING_FOR_APPROVAL.name());
        });
        List<CountryCurrency> entities = masterMapper.mapDtoToEntity(dtos);
        List<CountryCurrency> savedEntities = countryCurrencyRepository.saveAll(entities);
        logger.info("Bulk create completed. {} CountryCurrency record(s) persisted", savedEntities.size());
        return masterMapper.mapEntityToDto(savedEntities);
    }

    /**
     * Applies a workflow action (approve/reject/inactivate) to the given record ids.
     *
     * @param ids    the record ids to act upon
     * @param action the workflow action to apply; unrecognized actions are no-ops
     */
    public void performAction(List<UUID> ids, MasterAction action) {
        logger.info("Performing action: {} on {} CountryCurrency record(s)", action, ids.size());
        switch (action) {
            case APPROVED -> countryCurrencyRepository.approve(ids, MasterAction.APPROVED.name());
            case PENDING_FOR_REJECTED -> countryCurrencyRepository.performAction(ids, MasterAction.PENDING_FOR_REJECTED.name());
            case PENDING_FOR_INACTIVE -> countryCurrencyRepository.performAction(ids, MasterAction.PENDING_FOR_INACTIVE.name());
        }
        logger.info("Action: {} completed for CountryCurrency record(s)", action);
    }

    /**
     * Searches CountryCurrency records matching the given specification, with pagination.
     *
     * @param specification the filter criteria to apply
     * @param pageable      pagination and sorting details
     * @return a page of matching records mapped to DTO
     */
    public Page<CountryCurrencyDto> findBySpecification(Specification<CountryCurrency> specification, Pageable pageable) {
        logger.info("Searching CountryCurrency records with pagination: {}", pageable);
        Page<CountryCurrency> page = countryCurrencyRepository.findAll(specification, pageable);
        logger.info("Search returned {} record(s) out of {} total", page.getNumberOfElements(), page.getTotalElements());
        return page.map(masterMapper::mapEntityToDto);
    }

    /**
     * Finds an existing ACTIVE and APPROVED CountryCurrency record matching the given
     * code, name, currency code, and currency name. Used to validate inactivation requests.
     *
     * @param dto the DTO carrying the lookup criteria (code, name, currencyCode, currencyName)
     * @return the matching active/approved record, if present
     */
    public Optional<CountryCurrencyDto> findCountryCurrencyDtls(CountryCurrencyDto dto) {
        logger.info("Finding active approved CountryCurrency for code: {}, currencyCode: {}", dto.getCode(), dto.getCurrencyCode());
        Optional<CountryCurrency> countryCurrency = countryCurrencyRepository.findByCodeAndNameAndCurrencyCodeAndCurrencyNameAndStatusAndAction(
                dto.getCode(), dto.getName(), dto.getCurrencyCode(), dto.getCurrencyName(), "ACTIVE", "APPROVED");
        logger.info("Active approved CountryCurrency found: {}", countryCurrency.isPresent());
        return countryCurrency.map(masterMapper::mapEntityToDto);
    }

    /**
     * Finds an existing CountryCurrency record (regardless of status/action) matching
     * the given code, name, currency code, and currency name. Used to detect duplicates
     * before creation.
     *
     * @param dto the DTO carrying the lookup criteria (code, name, currencyCode, currencyName)
     * @return the matching record, if present
     */
    public Optional<CountryCurrencyDto> findCountryCurrency(CountryCurrencyDto dto) {
        logger.info("Checking existing CountryCurrency for code: {}, currencyCode: {}", dto.getCode(), dto.getCurrencyCode());
        Optional<CountryCurrencyDto> result = countryCurrencyRepository.findByCodeAndNameAndCurrencyCodeAndCurrencyName(
                dto.getCode(), dto.getName(), dto.getCurrencyCode(), dto.getCurrencyName()).map(masterMapper::mapEntityToDto);
        logger.info("Existing CountryCurrency found: {}", result.isPresent());
        return result;
    }
}





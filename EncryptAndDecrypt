    public List<MasterType> getParentCodes() {
        return List.of();
    }

    /**
     * @return the DTO class handled by this service
     */
    @Override
    public Class<CountryCurrencyDto> getDtoClass() {
        return CountryCurrencyDto.class;
    }

    /**
     * Converts the generic incoming request payload into a {@link CountryCurrencyDto}.
     *
     * @param masterRequest the raw request payload
     * @return the converted DTO
     */
    @Override
    public CountryCurrencyDto mapToMasterDto(MasterRequest masterRequest) {
        logger.info("Mapping MasterRequest to CountryCurrencyDto");
        return objectMapper.convertValue(masterRequest.getData(), CountryCurrencyDto.class);

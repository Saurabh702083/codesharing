     * Builds a workflow entry describing an action performed on a country-currency record.
     *
     * @param dto              the country-currency record the action applies to
     * @param workflowOperation the operation performed
     * @param remark           the remark/reason to attach to the workflow entry
     * @return the constructed workflow DTO
     */
    @Override
    public MasterWorkFlowDto mapToMasterWorkFlowDto(CountryCurrencyDto dto, WorkflowOperation workflowOperation, String remark) {
        return MasterWorkFlowDto.builder().masterCode(MasterType.COUNTRY_CURRENCY).action(workflowOperation).remark(remark).entityId(dto.getId().toString()).build();

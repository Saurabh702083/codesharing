@Component
@RequiredArgsConstructor
public class UserSearchValidator {

    private final UserSearchDao userSearchDao;

    private static final Map<SystemRole, Set<UserSearchView>> SCREEN_ACCESS =
            Map.of(
                    SystemRole.MASTER_ADMIN,
                    Set.of(
                            UserSearchView.MANAGE_SUPER_ADMINS,
                            UserSearchView.APPROVE_GROUP_ADMINS
                    ),

                    SystemRole.SUPER_ADMIN,
                    Set.of(
                            UserSearchView.MANAGE_GROUP_ADMINS,
                            UserSearchView.APPROVE_GROUP_USERS
                    ),

                    SystemRole.BIZ_GROUP_ADMIN,
                    Set.of(UserSearchView.MANAGE_GROUP_USERS),

                    SystemRole.BANK_IT_GROUP_ADMIN,
                    Set.of(UserSearchView.MANAGE_GROUP_USERS),

                    SystemRole.OPS_ITDCR_GROUP_ADMIN,
                    Set.of(UserSearchView.MANAGE_GROUP_USERS),

                    SystemRole.CMD_GROUP_ADMIN,
                    Set.of(UserSearchView.MANAGE_GROUP_USERS)
            );


    private static final Map<SystemRole, Set<String>> ROLE_HIERARCHY =
            Map.ofEntries(

                    Map.entry(
                            SystemRole.BIZ_GROUP_ADMIN,
                            Set.of(
                                    "BIZ_SUPPORT",
                                    "ONBOARDING_MANAGER",
                                    "RELATIONSHIP_MANAGER",
                                    "CHANNEL_MANAGER",
                                    "CHANNELS_ADMIN",
                                    "CHANNELS_USER",
                                    "CIRCLE_ADMIN",
                                    "CIRCLE_USER"
                            )
                    ),

                    Map.entry(
                            SystemRole.BANK_IT_GROUP_ADMIN,
                            Set.of(
                                    "PRODUCTION_SUPPORT",
                                    "MERCHANT_SUPPORT",
                                    "BANK_IT"
                            )
                    ),

                    Map.entry(
                            SystemRole.OPS_ITDCR_GROUP_ADMIN,
                            Set.of("OPERATIONS")
                    ),

                    Map.entry(
                            SystemRole.CMD_GROUP_ADMIN,
                            Set.of(
                                    "CUSTOMER_SUPPORT",
                                    "CHARGEBACK_TEAM"
                            )
                    )
            );


    private static final Set<String> GROUP_ADMIN_ROLES =
            Set.of(
                    "BIZ_GROUP_ADMIN",
                    "BANK_IT_GROUP_ADMIN",
                    "OPS_ITDCR_GROUP_ADMIN",
                    "CMD_GROUP_ADMIN"
            );


    /**
     * Main validation method.
     *
     * Returns criteria only after all validations pass.
     */
    public UserSearchCriteria validateAndBuildCriteria(
            UserSearchRequest request) {

        // 1. Get logged-in user details from JWT

        String adId = EPayIdentityUtil
                .getUserPrincipal()
                .getUserName();

        if (StringUtils.isBlank(adId)) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "Unable to identify logged-in user."
            );
        }


        // 2. Get logged-in user from database

        Users loggedInUser =
                userSearchDao.getUserByAdId(adId);


        if (loggedInUser == null) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "Logged-in user does not exist."
            );
        }


        if (loggedInUser.getAggregatorId() == null) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "User aggregator details are missing."
            );
        }


        // 3. Fetch logged-in user's primary role assignment

        UserRole primaryAssignment =
                userSearchDao.getPrimaryUserRole(
                        loggedInUser.getId(),
                        loggedInUser.getAggregatorId()
                );


        if (primaryAssignment == null) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "Primary role assignment not found."
            );
        }


        // 4. Fetch primary role definition

        BusinessRolesMaster primaryRole =
                userSearchDao.getRoleById(
                        primaryAssignment.getRoleId()
                );


        if (primaryRole == null) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "Primary role definition not found."
            );
        }


        // 5. Convert role code to enum

        SystemRole systemRole =
                SystemRole.fromValue(primaryRole.getBrCode());


        UserSearchContext context =
                UserSearchContext.builder()
                        .userId(loggedInUser.getId())
                        .aggregatorId(loggedInUser.getAggregatorId())
                        .primaryRoleId(primaryRole.getId())
                        .primaryRoleCode(primaryRole.getBrCode())
                        .businessGroupId(primaryRole.getBusinessGroupId())
                        .systemRole(systemRole)
                        .build();


        // 6. Validate requested screen

        validateScreenAccess(
                context.getSystemRole(),
                request.getViewType()
        );


        // 7. Determine permitted roles

        Set<String> permittedRoleCodes =
                getPermittedRoleCodes(context, request.getViewType());


        if (permittedRoleCodes.isEmpty()) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "No roles available for this search."
            );
        }


        // 8. Fetch permitted role IDs

        List<BusinessRolesMaster> roleDefinitions =
                userSearchDao.getRolesByCodes(
                        context.getAggregatorId(),
                        permittedRoleCodes
                );


        Set<UUID> permittedRoleIds =
                roleDefinitions.stream()
                        .map(BusinessRolesMaster::getId)
                        .collect(Collectors.toSet());


        if (permittedRoleIds.isEmpty()) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "No role definitions found."
            );
        }


        // 9. Build final criteria

        return UserSearchCriteria.builder()
                .aggregatorId(context.getAggregatorId())
                .roleIds(permittedRoleIds)
                .businessGroupId(
                        context.getBusinessGroupId()
                )
                .filters(request)
                .build();
    }


    private void validateScreenAccess(
            SystemRole loggedInRole,
            UserSearchView viewType) {

        Set<UserSearchView> allowedScreens =
                SCREEN_ACCESS.getOrDefault(
                        loggedInRole,
                        Collections.emptySet()
                );

        if (!allowedScreens.contains(viewType)) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    "You are not authorized to access this screen."
            );
        }
    }


    private Set<String> getPermittedRoleCodes(
            UserSearchContext context,
            UserSearchView viewType) {

        SystemRole loggedInRole = context.getSystemRole();

        switch (viewType) {

            case MANAGE_SUPER_ADMINS:

                return Set.of("SUPER_ADMIN");


            case APPROVE_GROUP_ADMINS:

            case MANAGE_GROUP_ADMINS:

                return GROUP_ADMIN_ROLES;


            case APPROVE_GROUP_USERS:

                return ROLE_HIERARCHY.values()
                        .stream()
                        .flatMap(Set::stream)
                        .collect(Collectors.toSet());


            case MANAGE_GROUP_USERS:

                Set<String> memberRoles =
                        ROLE_HIERARCHY.get(loggedInRole);

                if (memberRoles == null
                        || memberRoles.isEmpty()
                        || context.getBusinessGroupId() == null) {

                    throw new AdminPortalException(
                            ErrorConstants.INVALID_ERROR_CODE,
                            "Invalid Group Admin configuration."
                    );
                }

                return memberRoles;


            default:

                throw new AdminPortalException(
                        ErrorConstants.INVALID_ERROR_CODE,
                        "Invalid user search view."
                );
        }
    }
}



@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class UserSearchResponse {

    private UUID userId;

    private UUID userRoleId;

    private String adId;

    private String firstName;

    private String lastName;

    private String emailId;

    private String mobileNumber;

    private String designation;

    private String officeAddress;

    private UserStatus userStatus;

    private AuthStatus userAuthStatus;

    private UUID roleId;

    private String roleCode;

    private String roleName;


@Repository
@RequiredArgsConstructor
public class UserSearchDao {

    private final UsersRepository usersRepository;

    private final UserRoleRepository userRoleRepository;

    private final BusinessRolesMasterRepository rolesRepository;

    private final UserSearchQueryRepository searchQueryRepository;


    public Users getUserByAdId(String adId) {

        return usersRepository.findByAdIdAndDeletedAtIsNull(adId)
                .orElse(null);
    }


    public UserRole getPrimaryUserRole(
            UUID userId,
            UUID aggregatorId) {

        return userRoleRepository
                .findFirstByUserIdAndAggregatorIdAndIsPrimaryTrueAndIsActiveTrueAndAuthStatusAndDeletedAtIsNull(
                        userId,
                        aggregatorId,
                        AuthStatus.APPROVED
                )
                .orElse(null);
    }


    public BusinessRolesMaster getRoleById(UUID roleId) {

        return rolesRepository.findById(roleId)
                .orElse(null);
    }


    public List<BusinessRolesMaster> getRolesByCodes(
            UUID aggregatorId,
            Set<String> roleCodes) {

        return rolesRepository
                .findByAggregatorIdAndBrCodeInAndIsActiveTrue(
                        aggregatorId,
                        roleCodes
                );
    }


    public Page<UserSearchResponse> searchUsers(
            UserSearchCriteria criteria,
            Pageable pageable) {

        return searchQueryRepository.searchUsers(
                criteria,
                pageable
        );
    }

}


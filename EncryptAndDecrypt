@Repository
@RequiredArgsConstructor
public class UserSearchQueryRepositoryImpl
        implements UserSearchQueryRepository {

    @PersistenceContext
    private EntityManager entityManager;


    @Override
    public Page<UserSearchResponse> searchUsers(
            UserSearchCriteria criteria,
            Pageable pageable) {

        CriteriaBuilder cb =
                entityManager.getCriteriaBuilder();


        // ----------------------------------
        // DATA QUERY
        // ----------------------------------

        CriteriaQuery<Tuple> query =
                cb.createTupleQuery();

        Root<Users> user =
                query.from(Users.class);

        Root<UserRole> userRole =
                query.from(UserRole.class);

        Root<BusinessRolesMaster> role =
                query.from(BusinessRolesMaster.class);

        Root<BusinessGroupMaster> group =
                query.from(BusinessGroupMaster.class);


        List<Predicate> predicates =
                buildPredicates(
                        cb,
                        user,
                        userRole,
                        role,
                        group,
                        criteria
                );


        query.multiselect(

                user.get("id").alias("userId"),

                userRole.get("id").alias("userRoleId"),

                user.get("adId").alias("adId"),

                user.get("firstName").alias("firstName"),

                user.get("lastName").alias("lastName"),

                user.get("emailId").alias("emailId"),

                user.get("phoneNumber").alias("mobileNumber"),

                user.get("designation").alias("designation"),

                user.get("officeAddress").alias("officeAddress"),

                user.get("status").alias("userStatus"),

                user.get("authStatus").alias("userAuthStatus"),

                role.get("id").alias("roleId"),

                role.get("brCode").alias("roleCode"),

                role.get("name").alias("roleName"),

                group.get("id").alias("groupId"),

                group.get("bgCode").alias("groupCode"),

                group.get("name").alias("groupName"),

                userRole.get("isPrimary").alias("primaryRole"),

                userRole.get("isActive").alias("roleAssignmentActive"),

                userRole.get("recordStatus").alias("userRoleRecordStatus"),

                userRole.get("authStatus").alias("userRoleAuthStatus"),

                user.get("createdAt").alias("createdAt")
        );


        query.where(predicates.toArray(new Predicate[0]));


        // ----------------------------------
        // SORTING
        // ----------------------------------

        query.orderBy(buildOrders(
                cb,
                pageable,
                user,
                role,
                group
        ));


        TypedQuery<Tuple> typedQuery =
                entityManager.createQuery(query);


        typedQuery.setFirstResult(
                (int) pageable.getOffset()
        );

        typedQuery.setMaxResults(
                pageable.getPageSize()
        );


        List<UserSearchResponse> result =
                typedQuery.getResultList()
                        .stream()
                        .map(this::mapResponse)
                        .toList();


        // ----------------------------------
        // COUNT QUERY
        // ----------------------------------

        CriteriaQuery<Long> countQuery =
                cb.createQuery(Long.class);


        Root<Users> countUser =
                countQuery.from(Users.class);

        Root<UserRole> countUserRole =
                countQuery.from(UserRole.class);

        Root<BusinessRolesMaster> countRole =
                countQuery.from(BusinessRolesMaster.class);

        Root<BusinessGroupMaster> countGroup =
                countQuery.from(BusinessGroupMaster.class);


        List<Predicate> countPredicates =
                buildPredicates(
                        cb,
                        countUser,
                        countUserRole,
                        countRole,
                        countGroup,
                        criteria
                );


        countQuery.select(
                cb.countDistinct(countUserRole.get("id"))
        );

        countQuery.where(
                countPredicates.toArray(new Predicate[0])
        );


        Long total =
                entityManager.createQuery(countQuery)
                        .getSingleResult();


        return new PageImpl<>(
                result,
                pageable,
                total
        );
    }


    // ----------------------------------
    // DYNAMIC FILTER PREDICATES
    // ----------------------------------

    private List<Predicate> buildPredicates(
            CriteriaBuilder cb,
            Root<Users> user,
            Root<UserRole> userRole,
            Root<BusinessRolesMaster> role,
            Root<BusinessGroupMaster> group,
            UserSearchCriteria criteria) {


        List<Predicate> predicates =
                new ArrayList<>();


        UserSearchRequest filter =
                criteria.getFilters();


        // ----------------------------------
        // JOIN CONDITIONS
        // ----------------------------------

        predicates.add(
                cb.equal(
                        userRole.get("userId"),
                        user.get("id")
                )
        );


        predicates.add(
                cb.equal(
                        userRole.get("roleId"),
                        role.get("id")
                )
        );


        predicates.add(
                cb.equal(
                        role.get("businessGroupId"),
                        group.get("id")
                )
        );


        // ----------------------------------
        // AGGREGATOR VALIDATION
        // ----------------------------------

        predicates.add(
                cb.equal(
                        user.get("aggregatorId"),
                        criteria.getAggregatorId()
                )
        );

        predicates.add(
                cb.equal(
                        userRole.get("aggregatorId"),
                        criteria.getAggregatorId()
                )
        );

        predicates.add(
                cb.equal(
                        role.get("aggregatorId"),
                        criteria.getAggregatorId()
                )
        );

        predicates.add(
                cb.equal(
                        group.get("aggregatorId"),
                        criteria.getAggregatorId()
                )
        );


        // ----------------------------------
        // BASIC RECORD VALIDATIONS
        // ----------------------------------

        predicates.add(
                cb.isNull(user.get("deletedAt"))
        );

        predicates.add(
                cb.isNull(userRole.get("deletedAt"))
        );


        predicates.add(
                cb.isTrue(userRole.get("isPrimary"))
        );


        predicates.add(
                cb.isTrue(role.get("isActive"))
        );

        predicates.add(
                cb.isTrue(group.get("isActive"))
        );


        // ----------------------------------
        // PERMITTED ROLE IDS
        // ----------------------------------

        predicates.add(
                role.get("id").in(criteria.getRoleIds())
        );


        // ----------------------------------
        // GROUP RESTRICTION
        // ----------------------------------

        if (criteria.getBusinessGroupId() != null) {

            predicates.add(
                    cb.equal(
                            role.get("businessGroupId"),
                            criteria.getBusinessGroupId()
                    )
            );
        }


        // ----------------------------------
        // NAME FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getName())) {

            Expression<String> fullName =
                    cb.lower(
                            cb.concat(
                                    cb.concat(
                                            user.get("firstName"),
                                            " "
                                    ),
                                    user.get("lastName")
                            )
                    );

            predicates.add(
                    cb.like(
                            fullName,
                            "%" + filter.getName().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // ADID FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getAdId())) {

            predicates.add(
                    cb.like(
                            cb.lower(user.get("adId")),
                            "%" + filter.getAdId().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // EMAIL FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getEmailId())) {

            predicates.add(
                    cb.like(
                            cb.lower(user.get("emailId")),
                            "%" + filter.getEmailId().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // MOBILE FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getMobileNumber())) {

            predicates.add(
                    cb.like(
                            user.get("phoneNumber"),
                            "%" + filter.getMobileNumber().trim() + "%"
                    )
            );
        }


        // ----------------------------------
        // DESIGNATION FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getDesignation())) {

            predicates.add(
                    cb.like(
                            cb.lower(user.get("designation")),
                            "%" + filter.getDesignation().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // ROLE NAME FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getRoleName())) {

            predicates.add(
                    cb.like(
                            cb.lower(role.get("name")),
                            "%" + filter.getRoleName().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // GROUP NAME FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(filter.getGroupName())) {

            predicates.add(
                    cb.like(
                            cb.lower(group.get("name")),
                            "%" + filter.getGroupName().trim().toLowerCase() + "%"
                    )
            );
        }


        // ----------------------------------
        // USER STATUS FILTER
        // ----------------------------------

        if (filter.getUserStatus() != null) {

            predicates.add(
                    cb.equal(
                            user.get("status"),
                            filter.getUserStatus()
                    )
            );
        }


        // ----------------------------------
        // USER AUTH STATUS FILTER
        // ----------------------------------

        if (filter.getUserAuthStatus() != null) {

            predicates.add(
                    cb.equal(
                            user.get("authStatus"),
                            filter.getUserAuthStatus()
                    )
            );
        }


        // ----------------------------------
        // USER ROLE AUTH STATUS FILTER
        // ----------------------------------

        if (filter.getUserRoleAuthStatus() != null) {

            predicates.add(
                    cb.equal(
                            userRole.get("authStatus"),
                            filter.getUserRoleAuthStatus()
                    )
            );
        }


        // ----------------------------------
        // USER ROLE RECORD STATUS FILTER
        // ----------------------------------

        if (StringUtils.isNotBlank(
                filter.getUserRoleRecordStatus())) {

            predicates.add(
                    cb.equal(
                            cb.upper(userRole.get("recordStatus")),
                            filter.getUserRoleRecordStatus().trim().toUpperCase()
                    )
            );
        }


        // ----------------------------------
        // USER ROLE ACTIVE FILTER
        // ----------------------------------

        if (filter.getUserRoleActive() != null) {

            predicates.add(
                    cb.equal(
                            userRole.get("isActive"),
                            filter.getUserRoleActive()
                    )
            );
        }


        return predicates;
    }


    // ----------------------------------
    // SORTING
    // ----------------------------------

    private List<Order> buildOrders(
            CriteriaBuilder cb,
            Pageable pageable,
            Root<Users> user,
            Root<BusinessRolesMaster> role,
            Root<BusinessGroupMaster> group) {


        List<Order> orders = new ArrayList<>();


        if (pageable.getSort().isUnsorted()) {

            orders.add(
                    cb.desc(user.get("createdAt"))
            );

            return orders;
        }


        for (Sort.Order sortOrder : pageable.getSort()) {

            Expression<?> expression;

            switch (sortOrder.getProperty()) {

                case "createdAt":
                    expression = user.get("createdAt");
                    break;

                case "firstName":
                    expression = user.get("firstName");
                    break;

                case "lastName":
                    expression = user.get("lastName");
                    break;

                case "adId":
                    expression = user.get("adId");
                    break;

                case "roleName":
                    expression = role.get("name");
                    break;

                case "groupName":
                    expression = group.get("name");
                    break;

                case "userStatus":
                    expression = user.get("status");
                    break;

                default:
                    throw new AdminPortalException(
                            ErrorConstants.INVALID_ERROR_CODE,
                            "Invalid sorting field: " + sortOrder.getProperty()
                    );
            }


            orders.add(
                    sortOrder.isAscending()
                            ? cb.asc(expression)
                            : cb.desc(expression)
            );
        }


        return orders;
    }


    // ----------------------------------
    // TUPLE TO RESPONSE MAPPER
    // ----------------------------------

    private UserSearchResponse mapResponse(Tuple tuple) {

        return UserSearchResponse.builder()

                .userId(tuple.get("userId", UUID.class))

                .userRoleId(tuple.get("userRoleId", UUID.class))

                .adId(tuple.get("adId", String.class))

                .firstName(tuple.get("firstName", String.class))

                .lastName(tuple.get("lastName", String.class))

                .emailId(tuple.get("emailId", String.class))

                .mobileNumber(tuple.get("mobileNumber", String.class))

                .designation(tuple.get("designation", String.class))

                .officeAddress(tuple.get("officeAddress", String.class))

                .userStatus(tuple.get("userStatus", UserStatus.class))

                .userAuthStatus(tuple.get("userAuthStatus", AuthStatus.class))

                .roleId(tuple.get("roleId", UUID.class))

                .roleCode(tuple.get("roleCode", String.class))

                .roleName(tuple.get("roleName", String.class))

                .groupId(tuple.get("groupId", UUID.class))

                .groupCode(tuple.get("groupCode", String.class))

                .groupName(tuple.get("groupName", String.class))

                .primaryRole(tuple.get("primaryRole", Boolean.class))

                .roleAssignmentActive(tuple.get("roleAssignmentActive", Boolean.class))

                .userRoleRecordStatus(tuple.get("userRoleRecordStatus", String.class))

                .userRoleAuthStatus(tuple.get("userRoleAuthStatus", AuthStatus.class))

                .createdAt(tuple.get("createdAt", Long.class))

                .build();
    }

}




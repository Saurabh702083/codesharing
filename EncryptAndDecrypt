     * Validates that a maker-checker action (approve/reject/inactivate) can be
     * performed on the given bulk request.
     *
     * @param masters    the bulk request containing target record ids
     * @param actionName the name of the action being performed
     */
    @Override
    public void validateAction(MasterBulkRequest masters, String actionName) {
        logger.info("Validating action: {} for CountryCurrency bulk request", actionName);
        countryCurrencyValidator.validateAction(masters, actionName);
    }

    /**
     * Validates that the given records are in an eligible prior state for the
     * action being performed.
     *
     * @param masters         the records to validate
     * @param workflowActions the allowed prior workflow actions/states
     * @param performAction   the action about to be performed
     */
    @Override
    public void validateBulkMasters(List<CountryCurrencyDto> masters, List<String> workflowActions, String performAction) {
        logger.info("Validating {} CountryCurrency record(s) for action: {}", masters.size(), performAction);
        countryCurrencyValidator.validateBulkMasters(masters, workflowActions, performAction);
    }

    /**
     * Persists a country-currency record for CREATE or UPDATE, setting it to
     * status INACTIVE and action PENDING_FOR_APPROVAL prior to save.
     *
     * @param dto    the DTO to persist
     * @param action the operation being performed (CREATE or UPDATE)
     * @return the persisted record
     * @throws AdminPortalException if the action is not CREATE or UPDATE
     */
    @Override
    public CountryCurrencyDto save(CountryCurrencyDto dto, WorkflowOperation action) {
        logger.info("Saving CountryCurrencyDto for action: {}", action);
        dto.setStatus(MasterAction.INACTIVE.name());
        dto.setAction(MasterAction.PENDING_FOR_APPROVAL.name());
        switch (action) {
            case CREATE -> {
                return countryCurrencyDao.create(dto);
            }
            case UPDATE -> {
                return countryCurrencyDao.update(dto);
            }
        }
        throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, action.name()));
    }

    /**
     * Applies a maker-checker workflow action to the given record ids.
     *
     * @param ids    the record ids to act upon
     * @param action the workflow action to apply (APPROVE, REJECT, or INACTIVE)
     * @throws AdminPortalException if the action is not supported
     */
    @Override
    public void performAction(List<UUID> ids, WorkflowOperation action) {
        logger.info("Performing action: {} on {} CountryCurrency record(s)", action, ids.size());
        switch (action) {
            case APPROVE -> countryCurrencyDao.performAction(ids, MasterAction.APPROVED);
            case REJECT -> countryCurrencyDao.performAction(ids, MasterAction.PENDING_FOR_REJECTED);
            case INACTIVE -> countryCurrencyDao.performAction(ids, MasterAction.PENDING_FOR_INACTIVE);
            default ->
                    throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, action.name()));
        }
        logger.info("Action: {} completed successfully for {} record(s)", action, ids.size());
    }

    /**
     * Fetches country-currency records by id.
     *
     * @param ids the record ids to fetch
     * @return the matching records
     */

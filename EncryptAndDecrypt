            @PathVariable UserSearchTarget target,
            @RequestBody UserSearchRequest request,
            @PageableDefault(
                    size = 50,
                    sort = "createdAt",
                    direction = Sort.Direction.DESC
            ) Pageable pageable
    ) {

        return userSearchService.searchUsers(
                target,
                request,
                pageable
        );
    }

/**
 * Class Name: MasterBulkUploadService
 * <p>
 * Service layer supporting bulk upload of master data via CSV files.
 * Handles bulk-upload config lookup, upload-file record bookkeeping,
 * CSV parsing into row maps, and persistence of per-row upload details.
 * <p>
 * Author: V1018841(Saurabh Mahto)
 * <p>
 * Copyright (c) 2026 [State Bank of India]
 * All rights reserved
 * <p>
 * Version:1.0
 */
@Service
@RequiredArgsConstructor
public class MasterBulkUploadService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MasterBulkUploadConfigRepository configRepository;
    private final MasterBulkUploadFileRepository fileRepository;
    private final MasterBulkUploadFileDetailRepository fileDetailRepository;
    private final MasterBulkUploadValidation bulkUploadValidation;

    /**
     * Fetches the bulk-upload configuration for the given master type and
     * verifies that bulk upload is enabled for it.
     *
     * @param masterCode the master type code (e.g. COUNTRY_CURRENCY)
     * @return the bulk upload configuration for the master type
     * @throws AdminPortalException if no configuration exists for the master type
     * @throws ValidationException  if bulk upload is not allowed for the master type
     */
    public MasterBulkUploadConfig findConfigByMasterType(String masterCode) {
        logger.info("Fetching bulk upload config for masterType: {}", masterCode);
        MasterBulkUploadConfig config = configRepository.findByMasterTypeIgnoreCase(masterCode)
                .orElseThrow(() -> {
                    logger.error("Bulk upload config not found for masterType: {}", masterCode);
                    return new AdminPortalException(ErrorConstants.NOT_FOUND_ERROR_CODE, MessageFormat.format(ErrorConstants.NOT_FOUND_ERROR_MESSAGE, "Bulk upload config for " + masterCode));
                });
        if (!config.isBulkUploadAllowed()) {
            logger.error("Bulk upload is not allowed for masterType: {}", masterCode);
            throw new ValidationException(ErrorConstants.INVALID_ERROR_CODE, "Bulk upload is not allowed for masterType: " + masterCode);
        }
        logger.info("Bulk upload config fetched successfully for masterType: {}", masterCode);
        return config;
    }

    /**
     * Creates and persists a new {@link MasterBulkUploadFile} record representing
     * an uploaded file, in IN_PROGRESS state, before parsing begins.
     *
     * @param masterCode    the master type code the file belongs to
     * @param file          the uploaded multipart file
     * @param s3Path        the path/key where the file was stored on S3
     * @param masterConfigId the id of the associated bulk upload config
     * @param checksum      the checksum of the file content, used for duplicate detection
     * @return the persisted upload-file record
     */
    public MasterBulkUploadFile insertFileRecord(String masterCode, MultipartFile file, String s3Path, UUID masterConfigId, String checksum) {
        logger.info("Inserting file record for masterType: {}, fileName: {}", masterCode, file.getOriginalFilename());
        MasterBulkUploadFile uploadFile = MasterBulkUploadFile.builder().fileName(file.getOriginalFilename()).filePath(s3Path)
                .parsingStatus(BulkUploadParsingStatus.IN_PROGRESS).fileStatus(BulkUploadFileStatus.IN_PROGRESS).remark("File parsing is in progress.")
                .masterConfigId(masterConfigId).masterType(masterCode).fileChecksum(checksum).build();
        MasterBulkUploadFile saved = fileRepository.save(uploadFile);
        logger.info("File record inserted successfully with id: {}", saved.getId());
        return saved;
    }

    /**
     * Reads and parses a CSV upload file into a list of row maps keyed by header name.
     * Validates that the file is non-empty and that its headers match the expected
     * format configuration before parsing data rows. Blank lines and fully-blank
     * rows are skipped.
     *
     * @param file         the uploaded CSV file
     * @param formatConfig the expected file format configuration (headers, etc.)
     * @return list of records, each represented as a map of header -> cell value
     * @throws ValidationException     if the file is empty or headers are invalid
     * @throws AdminPortalException    if the file cannot be read
     */
    public List<Map<String, String>> readRecords(MultipartFile file, BulkUploadFormatConfig formatConfig) {
        logger.info("Reading records from uploaded file: {}", file.getOriginalFilename());
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(file.getInputStream(), StandardCharsets.UTF_8))) {
            List<String> nonBlankLines = reader.lines().map(String::trim).filter(StringUtils::isNotBlank).toList();
            if (nonBlankLines.isEmpty()) {
                logger.error("Bulk upload file is empty: {}", file.getOriginalFilename());
                throw new ValidationException(ErrorConstants.MANDATORY_ERROR_CODE, "Bulk upload file is empty.");
            }
            List<String> headers = parseCsvLine(nonBlankLines.getFirst());
            // validate Header
            bulkUploadValidation.validateHeaders(headers, formatConfig.getHeaders());
            //  Get List of record.
            List<Map<String, String>> records = new ArrayList<>();
            for (int i = 1; i < nonBlankLines.size(); i++) {
                List<String> values = parseCsvLine(nonBlankLines.get(i));
                if (values.stream().allMatch(StringUtils::isBlank)) {
                    continue;
                }
                Map<String, String> row = new LinkedHashMap<>();
                for (int index = 0; index < headers.size(); index++) {
                    row.put(headers.get(index), index < values.size() ? values.get(index).trim() : null);
                }
                records.add(row);
            }
            logger.info("Parsed {} record(s) from uploaded file: {}", records.size(), file.getOriginalFilename());
            return records;
        } catch (IOException e) {
            logger.error("Failed to read uploaded file: {}. Reason: {}", file.getOriginalFilename(), e.getMessage());
            throw new AdminPortalException(ErrorConstants.GENERIC_ERROR_CODE, ErrorConstants.GENERIC_ERROR_MESSAGE);
        }
    }

    /**
     * Persists the per-row processing details (status, remarks, linked master record id)
     * for a batch of bulk-uploaded records.
     *
     * @param detailEntities the row detail entities to persist
     */
    public void saveMasterFileDtls(List<MasterBulkUploadFileDetail> detailEntities) {
        logger.info("Saving {} bulk upload file detail record(s)", detailEntities.size());
        fileDetailRepository.saveAll(detailEntities);
        logger.info("Bulk upload file detail record(s) saved successfully");
    }

    /**
     * Splits a single CSV line into its trimmed cell values. Preserves trailing
     * empty cells (uses limit -1) so short rows aren't silently truncated.
     *
     * @param line the raw CSV line
     * @return the list of trimmed cell values
     */
    private List<String> parseCsvLine(String line) {
        return java.util.Arrays.stream(line.split(",", -1)).map(String::trim).toList();
    }

    /**
     * Persists updates to an existing {@link MasterBulkUploadFile} record, typically
     * used to update parsing/file status, remarks, and record counts.
     *
     * @param uploadFile the upload-file record with updated fields
     * @return the persisted upload-file record
     */
    public MasterBulkUploadFile updateFileRecord(MasterBulkUploadFile uploadFile) {
        logger.info("Updating file record with id: {}", uploadFile.getId());
        MasterBulkUploadFile updated = fileRepository.save(uploadFile);
        logger.info("File record updated successfully for id: {}", updated.getId());
        return updated;
    }

    /**
     * Generates a checksum for the given file's contents, used to detect duplicate uploads.
     *
     * @param file the uploaded multipart file
     * @return the computed checksum string
     */
    public String generateChecksum(MultipartFile file) {
        logger.info("Generating checksum for file: {}", file.getOriginalFilename());
        String checksum = AdminPortalUtil.generateChecksum(AdminPortalUtil.readFileBytes(file));
        logger.info("Checksum generated for file: {}", file.getOriginalFilename());
        return checksum;
    }

    /**
     * Checks whether the same file checksum already exists for the supplied master type.
     *
     * @param checksum file checksum
     * @return {@code true} when a duplicate upload exists
     */
    public boolean existsByFileChecksum(String checksum) {
        logger.info("Checking duplicate upload for checksum: {}", checksum);
        boolean exists = fileRepository.existsByFileChecksum(checksum);
        logger.info("Duplicate upload check result for checksum {}: {}", checksum, exists);
        return exists;
    }
}


            case UPDATE -> countryCurrencyValidator.validateUpdate(dto);
            default ->
                    throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, workflowOperation.name()));
        }
        logger.info("CountryCurrencyDto validated successfully for operation: {}", workflowOperation);
    }


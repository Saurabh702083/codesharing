public final class AdminUserSearchSpecification {

    private static final String MASTER_ADMIN = "MASTER_ADMIN";
    private static final String SUPER_ADMIN = "SUPER_ADMIN";

    private static final Set<String> GROUP_ADMIN_ROLE_CODES = Set.of(
            "BIZ_GROUP_ADMIN",
            "BANK_IT_GROUP_ADMIN",
            "OPS_ITDCR_GROUP_ADMIN",
            "CMD_GROUP_ADMIN"
    );

    private AdminUserSearchSpecification() {
    }

    public static Specification<AdminUserSearchView> buildSpecification(
            UserSearchTarget target,
            UserSearchRequest request,
            UserSearchScope scope
    ) {

        return Specification
                .where(hasTargetRole(target, scope))
                .and(hasAggregator(scope.getAggregatorId()))
                .and(hasGroupScope(target, scope))
                .and(hasAdId(request.getAdId()))
                .and(hasFirstName(request.getFirstName()))
                .and(hasLastName(request.getLastName()))
                .and(hasEmailId(request.getEmailId()))
                .and(hasPhoneNumber(request.getPhoneNumber()))
                .and(hasUserStatus(request.getUserStatus()))
                .and(hasUserType(request.getUserType()))
                .and(hasRoleCode(request.getRoleCode()))
                .and(hasRoleName(request.getRoleName()))
                .and(hasGroupName(request.getGroupName()))
                .and(hasAuthStatus(request.getAuthStatus()))
                .and(hasRoleActive(request.getRoleActive()))
                .and(createdFrom(request.getFromDate()))
                .and(createdTo(request.getToDate()));
    }

    /*
     * Target role filter
     */
    private static Specification<AdminUserSearchView> hasTargetRole(
            UserSearchTarget target,
            UserSearchScope scope
    ) {

        return (root, query, cb) -> {

            Set<String> allowedRoleCodes = scope.getAllowedRoleCodes();

            if (allowedRoleCodes == null || allowedRoleCodes.isEmpty()) {
                return cb.conjunction();
            }

            return root.get("roleCode").in(allowedRoleCodes);
        };
    }

    /*
     * Tenant filter
     */
    private static Specification<AdminUserSearchView> hasAggregator(
            UUID aggregatorId
    ) {

        return (root, query, cb) ->
                aggregatorId == null
                        ? cb.conjunction()
                        : cb.equal(root.get("aggregatorId"), aggregatorId);
    }

    /*
     * Group scope
     *
     * GROUP_ADMIN:
     *   Always logged-in user's group.
     *
     * SUPER_ADMIN:
     *   Selected group for GROUP_USERS.
     *
     * GROUP_ADMIN target:
     *   All groups.
     */
    private static Specification<AdminUserSearchView> hasGroupScope(
            UserSearchTarget target,
            UserSearchScope scope
    ) {

        return (root, query, cb) -> {

            if (target == UserSearchTarget.GROUP_ADMIN) {
                return cb.conjunction();
            }

            if (scope.isAllGroupsAllowed()) {
                return cb.conjunction();
            }

            if (scope.getBusinessGroupId() == null) {
                return cb.disjunction();
            }

            return cb.equal(
                    root.get("businessGroupId"),
                    scope.getBusinessGroupId()
            );
        };
    }

    private static Specification<AdminUserSearchView> hasAdId(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("adId"), value);
    }

    private static Specification<AdminUserSearchView> hasFirstName(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("firstName"), value);
    }

    private static Specification<AdminUserSearchView> hasLastName(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("lastName"), value);
    }

    private static Specification<AdminUserSearchView> hasEmailId(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("emailId"), value);
    }

    private static Specification<AdminUserSearchView> hasPhoneNumber(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("phoneNumber"), value);
    }

    private static Specification<AdminUserSearchView> hasUserStatus(String value) {

        return (root, query, cb) -> {

            if (!StringUtils.hasText(value)) {
                return cb.conjunction();
            }

            return cb.equal(
                    cb.upper(root.get("userStatus")),
                    value.trim().toUpperCase()
            );
        };
    }

    private static Specification<AdminUserSearchView> hasUserType(UserType value) {

        return (root, query, cb) -> {

            if (value == null) {
                return cb.conjunction();
            }

            return cb.equal(root.get("userType"), value);
        };
    }

    private static Specification<AdminUserSearchView> hasRoleCode(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("roleCode"), value);
    }

    private static Specification<AdminUserSearchView> hasRoleName(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("roleName"), value);
    }

    private static Specification<AdminUserSearchView> hasGroupName(String value) {

        return (root, query, cb) ->
                likeIgnoreCase(cb, root.get("groupName"), value);
    }

    private static Specification<AdminUserSearchView> hasAuthStatus(String value) {

        return (root, query, cb) -> {

            if (!StringUtils.hasText(value)
                    || "ALL".equalsIgnoreCase(value.trim())) {
                return cb.conjunction();
            }

            return cb.equal(
                    cb.upper(root.get("roleAuthStatus")),
                    value.trim().toUpperCase()
            );
        };
    }

    private static Specification<AdminUserSearchView> hasRoleActive(Boolean value) {

        return (root, query, cb) ->
                value == null
                        ? cb.conjunction()
                        : cb.equal(root.get("roleActive"), value);
    }

    /*
     * CREATED_AT is epoch value in milliseconds.
     */
    private static Specification<AdminUserSearchView> createdFrom(LocalDate date) {

        return (root, query, cb) -> {

            if (date == null) {
                return cb.conjunction();
            }

            long startEpoch = date
                    .atStartOfDay(ZoneId.systemDefault())
                    .toInstant()
                    .toEpochMilli();

            return cb.greaterThanOrEqualTo(
                    root.get("createdAt"),
                    startEpoch
            );
        };
    }

    private static Specification<AdminUserSearchView> createdTo(LocalDate date) {

        return (root, query, cb) -> {

            if (date == null) {
                return cb.conjunction();
            }

            long nextDayEpoch = date
                    .plusDays(1)
                    .atStartOfDay(ZoneId.systemDefault())
                    .toInstant()
                    .toEpochMilli();

            return cb.lessThan(
                    root.get("createdAt"),
                    nextDayEpoch
            );
        };
    }

    private static Predicate likeIgnoreCase(
            CriteriaBuilder cb,
            Expression<String> field,
            String value
    ) {

        if (!StringUtils.hasText(value)) {
            return cb.conjunction();
        }

        String searchValue = value.trim()
                .toLowerCase()
                .replace("\\", "\\\\")
                .replace("%", "\\%")
                .replace("_", "\\_");

        return cb.like(
                cb.lower(field),
                "%" + searchValue + "%",
                '\\'
        );
    }
}


@Service
@RequiredArgsConstructor
public class UserSearchScopeService {

    private static final String MASTER_ADMIN = "MASTER_ADMIN";
    private static final String SUPER_ADMIN = "SUPER_ADMIN";

    private static final Set<String> GROUP_ADMIN_ROLE_CODES = Set.of(
            "BIZ_GROUP_ADMIN",
            "BANK_IT_GROUP_ADMIN",
            "OPS_ITDCR_GROUP_ADMIN",
            "CMD_GROUP_ADMIN"
    );

    private final UsersRepository usersRepository;
    private final UserRoleRepository userRoleRepository;
    private final BusinessRolesMasterRepository businessRolesMasterRepository;

    public UserSearchScope resolveScope(
            UserSearchTarget target,
            UUID requestedGroupId,
            String loggedInAdId
    ) {

        Users loggedInUser = usersRepository
                .findByAdIdIgnoreCaseAndDeletedAtIsNull(loggedInAdId)
                .orElseThrow(() -> new AdminPortalException(
                        "USR_001",
                        "Logged-in user not found"
                ));

        UserRole primaryUserRole = userRoleRepository
                .findFirstByUserIdAndIsPrimaryTrueAndIsActiveTrueAndDeletedAtIsNull(
                        loggedInUser.getId()
                )
                .orElseThrow(() -> new AdminPortalException(
                        "USR_002",
                        "Primary active role not found"
                ));

        BusinessRolesMaster loggedInRole = businessRolesMasterRepository
                .findByIdAndIsActiveTrue(primaryUserRole.getRoleId())
                .orElseThrow(() -> new AdminPortalException(
                        "USR_003",
                        "Logged-in user's role not found"
                ));

        String loggedInRoleCode = loggedInRole.getBrCode();

        UUID aggregatorId = loggedInUser.getAggregatorId();

        // MASTER ADMIN
        if (MASTER_ADMIN.equals(loggedInRoleCode)) {

            if (target == UserSearchTarget.SUPER_ADMIN
                    || target == UserSearchTarget.GROUP_ADMIN) {

                return UserSearchScope.builder()
                        .aggregatorId(aggregatorId)
                        .allGroupsAllowed(true)
                        .build();
            }

            throw new AdminPortalException(
                    "USR_004",
                    "Master Admin is not authorized for this search"
            );
        }

        // SUPER ADMIN
        if (SUPER_ADMIN.equals(loggedInRoleCode)) {

            if (target == UserSearchTarget.GROUP_ADMIN) {
                return UserSearchScope.builder()
                        .aggregatorId(aggregatorId)
                        .allGroupsAllowed(true)
                        .build();
            }

            if (target == UserSearchTarget.GROUP_USERS) {

                if (requestedGroupId == null) {
                    throw new AdminPortalException(
                            "USR_005",
                            "Business group is required"
                    );
                }

                return UserSearchScope.builder()
                        .aggregatorId(aggregatorId)
                        .businessGroupId(requestedGroupId)
                        .allGroupsAllowed(false)
                        .build();
            }

            throw new AdminPortalException(
                    "USR_006",
                    "Super Admin is not authorized for this search"
            );
        }

        // GROUP ADMIN
        if (GROUP_ADMIN_ROLE_CODES.contains(loggedInRoleCode)) {

            if (target != UserSearchTarget.GROUP_USERS) {
                throw new AdminPortalException(
                        "USR_007",
                        "Group Admin can search only group users"
                );
            }

            UUID loggedInGroupId = loggedInRole.getBusinessGroupId();

            if (loggedInGroupId == null) {
                throw new AdminPortalException(
                        "USR_008",
                        "Group is not configured for logged-in user"
                );
            }

            // Do not allow Group Admin to search another group.
            if (requestedGroupId != null
                    && !loggedInGroupId.equals(requestedGroupId)) {
                throw new AdminPortalException(
                        "USR_009",
                        "You are not authorized to access this group"
                );
            }

            return UserSearchScope.builder()
                    .aggregatorId(aggregatorId)
                    .businessGroupId(loggedInGroupId)
                    .allGroupsAllowed(false)
                    .build();
        }

        throw new AdminPortalException(
                "USR_010",
                "You are not authorized to search users"
        );
    }
}


Corrected Specification target logic
The target itself determines which role codes are included. This is important because GROUP_USERS must exclude Group Admin roles even when the Super Admin searches across a selected group.

Replace the hasTargetRole() method in AdminUserSearchSpecification with this implementation:
private static Specification<AdminUserSearchView> hasTargetRole(
        UserSearchTarget target
) {

    return (root, query, cb) -> {

        switch (target) {

            case SUPER_ADMIN:
                return cb.equal(
                        root.get("roleCode"),
                        "SUPER_ADMIN"
                );

            case GROUP_ADMIN:
                return root.get("roleCode").in(
                        GROUP_ADMIN_ROLE_CODES
                );

            case GROUP_USERS:
                return cb.not(
                        root.get("roleCode").in(
                                GROUP_ADMIN_ROLE_CODES
                        )
                );

            default:
                return cb.disjunction();
        }
    };
}

Also replace hasGroupScope() with:
private static Specification<AdminUserSearchView> hasGroupScope(
        UserSearchTarget target,
        UserSearchScope scope
) {

    return (root, query, cb) -> {

        // Group Admin and Super Admin target: all groups.
        if (target == UserSearchTarget.GROUP_ADMIN) {
            return cb.conjunction();
        }

        // SUPER_ADMIN and GROUP_USERS and GROUP_ADMIN and GROUP_USERS
        // both have a specific group ID.
        if (scope.getBusinessGroupId() == null) {
            return cb.disjunction();
        }

        return cb.equal(
                root.get("businessGroupId"),
                scope.getBusinessGroupId()
        );
    };
}



@Repository
@RequiredArgsConstructor
@Slf4j
public class AdminPortalLogDao {

    private final AdminPortalLogRepository adminPortalLogRepository;

    public AdminPortalAPILog saveRequest(
            String encryptedRequest,
            String requestJson,
            String externalMid) {

        AdminPortalAPILog apiLog = AdminPortalAPILog.builder()
                .apiPath("/payModeMapping/upi/MECode")
                .mId(externalMid)
                .requestPayloadDecrypted(requestJson)
                .requestPayloadEncrypted(encryptedRequest)
                .status("IN_PROGRESS")
                .build();

        return adminPortalLogRepository.save(apiLog);
    }

    public void updateSuccess(
            AdminPortalAPILog apiLog,
            String encryptedResponse,
            String decryptedResponse) {

        apiLog.setResponsePayloadEncrypted(encryptedResponse);
        apiLog.setResponsePayloadDecrypted(decryptedResponse);
        apiLog.setStatus("SUCCESS");

        adminPortalLogRepository.save(apiLog);
    }

    public void updateFailure(
            AdminPortalAPILog apiLog,
            String errorCode) {

        apiLog.setStatus("FAILED");

        // Store a controlled error code in an existing error column
        // if your entity supports it. Never persist secrets or stack traces.
        adminPortalLogRepository.save(apiLog);

        log.warn(
                "UPI audit record marked failed | errorCode={}",
                errorCode
        );
    }
}





package com.epay.admin.portal.dao;

import com.epay.admin.portal.config.AdminPortalConfig;
import com.epay.admin.portal.exceptions.UpiIntegrationError;
import com.epay.admin.portal.exceptions.UpiIntegrationException;
import com.epay.admin.portal.externalservice.UpiServiceClient;
import com.epay.admin.portal.externalservice.request.UpiGenericRequest;
import com.epay.admin.portal.externalservice.response.UpiAccessTokenResponseDto;
import com.epay.admin.portal.externalservice.response.UpiGenericResponse;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Repository;

@Slf4j
@Repository
@RequiredArgsConstructor
public class MeCodeGenerationDao {

    private final UpiServiceClient upiServiceClient;
    private final AdminPortalConfig adminPortalConfig;
    private final ObjectMapper objectMapper;

    @Value("${UPI.OAUTH_TOKEN_URL}")
    private String upiAuthTokenUrl;

    @Value("${UPI.SUB-MERCHANT_ONBOARDING_URL}")
    private String upiMeCodeGenUrl;

    public UpiAccessTokenResponseDto generateAccessToken(
            String correlationId) {

        UpiAccessTokenResponseDto response =
                upiServiceClient.initiateUpiAccessToken(
                        upiAuthTokenUrl,
                        adminPortalConfig.getUpiClientId(),
                        adminPortalConfig.getUpiClientSecret(),
                        adminPortalConfig.getUpiOAuthUsername(),
                        adminPortalConfig.getUpiOAuthPassword(),
                        correlationId,
                        UpiAccessTokenResponseDto.class
                );

        if (response.getAccessToken() == null
                || response.getAccessToken().isBlank()) {

            log.error(
                    "UPI access token missing | correlationId={}",
                    correlationId
            );

            throw new UpiIntegrationException(
                    UpiIntegrationError.TOKEN_MISSING,
                    "UPI access token is missing from the response"
            );
        }

        log.info(
                "UPI access token received | correlationId={} | tokenType={} " +
                "| expiresInSeconds={}",
                correlationId,
                response.getTokenType(),
                response.getExpiresIn()
        );

        // Never log the token or refresh token.
        return response;
    }

    public UpiGenericResponse initiateUpiPostRequest(
            String encryptedUpiRequest,
            UpiAccessTokenResponseDto token,
            String correlationId) {

        return upiServiceClient.initiateUpiRequest(
                upiMeCodeGenUrl,
                encryptedUpiRequest,
                token.getAccessToken(),
                correlationId,
                UpiGenericResponse.class
        );
    }

    public String serializeRequest(UpiGenericRequest request) {
        try {
            return objectMapper.writeValueAsString(request);
        } catch (Exception ex) {
            throw new UpiIntegrationException(
                    UpiIntegrationError.ONBOARDING_REQUEST_FAILED,
                    "Unable to serialize UPI request",
                    null,
                    ex
            );
        }
    }
}

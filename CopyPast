public interface PaygatewayMasterRepository  extends JpaRepository<PaygatewayMaster, Long> {

    @Query(value = """
            SELECT mc.CURRENCY_COMB_CODE      AS "currencyCombCode",
                               cp.PAYMODE_CODE            AS "paymodeCode",
                               g.ID                       AS "gatewayId",
                               gm.gateway_name             AS "gatewayName",
                               g.PAYPROC_ID               AS "payProcId",
                               g.PAYPROC_TYPE             AS "payProcType",
                               g.ME_CODE                  AS "meCode",
                               g.TEMPLATE_PATH            AS "templatePath"
                        FROM   MERCHANT_CURRENCY_COMBINATION_MAPPING mc
                        JOIN   CURRENCY_COMB_PAYMODE_MAPPING cp
                               ON  cp.AGGREGATOR_CODE    = mc.AGGREGATOR_CODE
                               AND cp.CURRENCY_COMB_CODE = mc.CURRENCY_COMB_CODE
                        JOIN   PAYGATEWAY_MASTER g
                               ON  g.AGGREGATOR_CODE     = cp.AGGREGATOR_CODE
                               AND g.CURRENCY_COMB_CODE  = cp.CURRENCY_COMB_CODE
                               AND g.PAYMODE_CODE        = cp.PAYMODE_CODE
                        JOIN  GATEWAY_MASTER gm
                              on  g.gateway_id = gm.gateway_id
                        LEFT JOIN MERCHANT_PAYMODE_MAPPING mp
                               ON  mp.MERCHANT_ID        = mc.MERCHANT_ID
                               AND mp.AGGREGATOR_CODE    = cp.AGGREGATOR_CODE
                               AND mp.PAYMODE_CODE       = cp.PAYMODE_CODE
                        WHERE  mc.MERCHANT_ID = :mId
                        ORDER BY mc.CURRENCY_COMB_CODE, cp.PAYMODE_CODE, g.AGGREGATOR_CODE
            """, nativeQuery = true)
    List<MeCodeMappingProjection> findMeCodeMappingByMerchantId(@Param("mId") String mId);

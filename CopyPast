private Map<String, Object> diff(Object oldDto, Object newDto) {
    Map<String, Object> o = toMap(oldDto);
    Map<String, Object> n = toMap(newDto);
    Object pendingId = n.get("id");

    n.entrySet().removeIf(e -> IGNORE.contains(e.getKey())
                            || Objects.equals(o.get(e.getKey()), e.getValue()));
    if (n.isEmpty()) return null;

    Map<String, Object> result = new LinkedHashMap<>();
    result.put("id", pendingId);
    result.putAll(n);
    return result;
}










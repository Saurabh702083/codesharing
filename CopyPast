private void checkChangeRequest(MerchantJourneyRequest mifJourneyRequest, OnboardingStage stage) {
        if (OnboardingStage.RISK_SCORE_APPROVAL.equals(stage)) {
            ApproveChangeRequest approveChangeRequest = merchantOnboardingDao.checkChangeRequest(mifJourneyRequest.getMerchantMIFId());
            if(ObjectUtils.isNotEmpty(approveChangeRequest)){
                if(MIFStatus.APPROVED.name().equals(mifJourneyRequest.getMifStatus())){
                    approveChangeRequest.setApproved(true);
                    merchantOnboardingDao.updateMIFChangeRequest(mifJourneyRequest.getMerchantMIFId(), approveChangeRequest);
                    logger.info("update merchant journey status.");
                    String mId= merchantMIFDao.isMidGenerated(mifJourneyRequest.getMerchantMIFId());
                    if (StringUtils.isNotEmpty(mId)) {
                        logger.info("Update Merchant info as mid :{} has been generated for mifId :{}",mId, mifJourneyRequest.getMerchantMIFId());
                        merchantRegistrationDao.updateMerchantInfo(mifJourneyRequest.getMerchantMIFId(), mId);
                    }
                }else if(MIFStatus.REJECTED.name().equals(mifJourneyRequest.getMifStatus())) {
                approveChangeRequest.setApproved(false);
                merchantOnboardingDao.updateMIFChangeRequest(mifJourneyRequest.getMerchantMIFId(), approveChangeRequest);
                }
            }
        }
    }


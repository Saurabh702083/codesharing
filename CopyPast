package com.epay.admin.portal.service;

import com.epay.admin.portal.entity.admin.VwUserRoleList;
import com.epay.admin.portal.enums.AuthStatus;
import com.epay.admin.portal.enums.SystemRole;
import com.epay.admin.portal.exception.AdminPortalException;
import com.epay.admin.portal.model.request.AdminUserListRequest;
import com.epay.admin.portal.model.response.AdminPortalResponse;
import com.epay.admin.portal.model.response.UserRoleListDto;
import com.epay.admin.portal.repository.BusinessRolesMasterRepository;
import com.epay.admin.portal.repository.VwUserRoleListRepository;
import com.epay.admin.portal.specification.UserRoleListSpecification;
import com.epay.admin.portal.util.EPayIdentityUtil;
import com.epay.admin.portal.util.UserListAccessPolicy;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.text.MessageFormat;
import java.util.Set;
import java.util.UUID;

import static com.epay.admin.portal.util.ErrorConstants.*;   // INVALID_ERROR_CODE, INVALID_ENUM_ERROR_CODE/MESSAGE - adjust imports

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminUserListService {

    private final VwUserRoleListRepository vwUserRoleListRepository;
    private final BusinessRolesMasterRepository businessRolesMasterRepository;

    @Transactional(readOnly = true)
    public AdminPortalResponse<UserRoleListDto> getUserRoleList(AdminUserListRequest request, Pageable pageable) {
        validateRequest(request);

        // 1. who is calling (from the JWT)
        SystemRole caller = UserListAccessPolicy.resolveCallerRole(EPayIdentityUtil.getUserPrincipal().getUserRole());
        log.debug("User list requested by role {} for listType {}", caller, request.getListType());

        // 2. what may they see for this list type
        Set<String> roleCodes = UserListAccessPolicy.resolveRoleCodes(caller, request.getListType(), request.getRoleCode());

        // 3. group admins are locked to their own group
        UUID groupId = UserListAccessPolicy.GROUP_ADMIN_ROLES.contains(caller)
                ? businessRolesMasterRepository.findBusinessGroupIdByBrCode(caller.getValue())
                    .orElseThrow(() -> new AdminPortalException(UserListAccessPolicy.ACCESS_DENIED_ERROR_CODE,
                            UserListAccessPolicy.ACCESS_DENIED_ERROR_MESSAGE))
                : null;

        // 4. filters
        Specification<VwUserRoleList> specification = UserRoleListSpecification.searchUserRoles(
                request, roleCodes, groupId, parseActive(request.getStatus()), parseAuthStatus(request.getAuthStatus()));

        Page<UserRoleListDto> page = vwUserRoleListRepository.findAll(specification, pageable).map(this::toDto);

        return AdminPortalResponse.<UserRoleListDto>builder()
                .status(HttpStatus.OK.value())
                .data(page.getContent())
                .count((long) page.getNumberOfElements())
                .total(page.getTotalElements())
                .build();
    }

    private void validateRequest(AdminUserListRequest request) {
        if (request.getFrom() != null && request.getTo() != null && request.getFrom() > request.getTo()) {
            throw new AdminPortalException(INVALID_ERROR_CODE, "'from' date cannot be after 'to' date");
        }
    }

    private Boolean parseActive(String status) {
        if (StringUtils.isBlank(status)) return null;
        if ("ACTIVE".equalsIgnoreCase(status)) return Boolean.TRUE;
        if ("INACTIVE".equalsIgnoreCase(status)) return Boolean.FALSE;
        throw new AdminPortalException(INVALID_ENUM_ERROR_CODE, MessageFormat.format(INVALID_ENUM_ERROR_MESSAGE, "Status"));
    }

    private AuthStatus parseAuthStatus(String authStatus) {
        return StringUtils.isBlank(authStatus) ? null : AuthStatus.getMerchantRisK(authStatus);
    }

    private UserRoleListDto toDto(VwUserRoleList v) {
        return UserRoleListDto.builder()
                .userRoleId(toStr(v.getUserRoleId()))
                .userId(toStr(v.getUserId()))
                .adId(v.getAdId())
                .name(v.getFullName())
                .designation(v.getDesignation())
                .emailId(v.getEmailId())
                .phoneNumber(v.getPhoneNumber())
                .roleId(toStr(v.getRoleId()))
                .roleCode(v.getRoleCode())
                .roleName(v.getRoleName())
                .groupId(toStr(v.getGroupId()))
                .groupCode(v.getGroupCode())
                .groupName(v.getGroupName())
                .createdDate(v.getUserCreatedAt())
                .status(Boolean.TRUE.equals(v.getIsActive()) ? "ACTIVE" : "INACTIVE")
                .authStatus(v.getAuthStatus() == null ? null : v.getAuthStatus().name())
                .userStatus(v.getUserStatus())
                .build();
    }

    private String toStr(UUID id) {
        return id == null ? null : id.toString();
    }
}

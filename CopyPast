@Data
@RequiredArgsConstructor
@RestController
@RequestMapping("/payModeMapping")
public class PayModeMappingController {
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final PayModeMappingService payModeService;

   @PreAuthorize("hasAnyRole('ONBOARDING_MANAGER','BIZ_SUPPORT')")
    @GetMapping("/meCodeMapping/{mId}")
    @Operation(summary = "Get ME code details for merchant id for maker and checker")
    public AdminPortalResponse<MeCodeMappingDto> getMECodeMappingDetails(@PathVariable("mId") String mId) {
        logger.info("Getting merchant RFC for by mId: {}", mId);
        return payModeService.getMECodeDetails(mId);
    }

    @PreAuthorize("hasAnyRole('BIZ_SUPPORT')")
    @PostMapping("/meCodingMapping/{mId}")
    @Operation(summary = "Get ME code details for merchant id for maker and checker")
    public AdminPortalResponse<String> submitMECodeMapping(@PathVariable("mId") String mId, @RequestBody List<MeCodeMappingRequest> meCodeMappingRequests){
        logger.info("submit meCoding mapping for mId : {}",mId);
        return payModeService.submitMECodingMapping(mId,meCodeMappingRequests);
    }
}


@Service
@Data
@RequiredArgsConstructor
public class PayModeMappingService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MerchantValidator merchantValidator;
    private final MerchantCurrencyCombinationMappingDao merchantCurrencyCombinationMappingDao;
    private final PayModeMappingDao paymodeMappingDao;
    private final MeCodeMappingMapper mapper;


    public AdminPortalResponse<MeCodeMappingDto> getMECodeDetails(String mId) {
        logger.info("Validating mId: {}", mId);
        merchantValidator.validateMid(mId);
        //TODO check previous step is completed or not.
        logger.info("Fetching saved paygateway mappings for mId: {}", mId);
        Map<Long, MerchantPaygatewayMapping> savedMappings = paymodeMappingDao.fetchSavedMerchantPaygateway(mId)
                .stream().collect(Collectors.toMap(MerchantPaygatewayMapping::getPaygatewayId, Function.identity(), (existing, duplicate) -> existing));
        logger.info("Fetching master mappings for mId: {}", mId);
        List<MeCodeMappingProjection> masterMappings = paymodeMappingDao.findMeCodeMappingByMerchantId(mId);
        List<MeCodeMappingDto> result = masterMappings.stream().map(projection -> buildResultDto(projection, savedMappings)).toList();
        return AdminPortalResponse.<MeCodeMappingDto>builder().data(result).status(SUCCESS_RESPONSE_CODE).build();
    }

    private MeCodeMappingDto buildResultDto(MeCodeMappingProjection projection, Map<Long, MerchantPaygatewayMapping> savedMappings) {
        MeCodeMappingDto dto = mapper.toDto(projection);
        MerchantPaygatewayMapping saved = savedMappings.get(projection.getPaygatewayId());
        if (ObjectUtils.isNotEmpty(saved)) {
            mapper.updateDto(saved, dto);
        }
        return dto;
    }


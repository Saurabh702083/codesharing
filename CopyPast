@Service
@RequiredArgsConstructor
public class AdminMasterService {
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MasterHandlerFactory<BaseMasterDto> masterHandlerFactory;
    private final MasterWorkFlowService masterWorkFlowService;
    private final String message = "{0} action perform successfully.";

@Transactional
    public AdminPortalResponse<String> approve(MasterBulkRequest request, String masterCode) {
        return performAction(request, WorkflowOperation.APPROVE, List.of(WorkflowAction.PENDING_FOR_APPROVAL.name(), WorkflowAction.PENDING_FOR_INACTIVE.name(),  WorkflowAction.PENDING_FOR_REJECTED.name()), masterCode);
    }

    @Transactional
    public AdminPortalResponse<String> reject(MasterBulkRequest request, String masterCode) {
        return performAction(request, WorkflowOperation.REJECT, List.of(WorkflowAction.PENDING_FOR_APPROVAL.name(), WorkflowAction.PENDING_FOR_INACTIVE.name()), masterCode);
    }

    @Transactional
    public AdminPortalResponse<String> inactive(MasterBulkRequest request, String masterCode) {
        return performAction(request, WorkflowOperation.INACTIVE, List.of(WorkflowAction.APPROVED.name()), masterCode);
    }

    private AdminPortalResponse<String> performAction(MasterBulkRequest request, WorkflowOperation performOperation, List<String> allowedPreviousActions, String masterCode) {
        BaseMasterService<BaseMasterDto> masterService = resolveMasterService(masterCode);

        List<BaseMasterDto> masters = masterService.findByIds(request.getMasterIds());
        masterService.validateBulkMasters(masters, allowedPreviousActions, performOperation.name());
        logger.info("Request validated successfully for operation : {}.", performOperation.name());

        masterService.performAction(request.getMasterIds(), performOperation);
        logger.info(" {} : Operation performed successfully for master code: {}", performOperation.name(), masterCode);

        String remarks = StringUtils.isNotEmpty(request.getRemarks()) ? request.getRemarks() : MessageFormat.format(message, performOperation.name());
        List<MasterWorkFlowDto> masterWorkFlowDtos = masters.stream().map(master -> masterService.mapToMasterWorkFlowDto(master, performOperation, remarks)).toList();
        masterWorkFlowService.save(masterWorkFlowDtos);
        logger.info("Master flow record saved of :{}, for Operation : {}", masterCode, performOperation.name());

        return mapToResponse(MessageFormat.format(message, performOperation.name()));
    }

    private BaseMasterService<BaseMasterDto> resolveMasterService(String masterCode) {
        MasterType masterType = MasterType.getMasterType(masterCode);
        logger.info("Master request for: {}", masterType);
        return masterHandlerFactory.getMasterService(masterType.getCode());
    }

    private AdminPortalResponse<String> mapToResponse(String s) {
        return AdminPortalResponse.<String>builder().status(SUCCESS_RESPONSE_CODE).data(List.of(s)).count(1L).total(1L).build();
    }
}

@Service("countryCurrencyService")
@Data
@RequiredArgsConstructor
public class CountryCurrencyService implements BaseMasterService<CountryCurrencyDto> {

    private final CountryCurrencyMasterValidator countryCurrencyValidator;
    private final CountryCurrencyDao countryCurrencyDao;
    private final ObjectMapper objectMapper;

    @Override
    public MasterType getMasterCode() {
        return MasterType.COUNTRY_CURRENCY;
    }

    @Override
    public List<MasterType> getParentCodes() {
        return List.of();
    }

    @Override
    public CountryCurrencyDto mapToMasterDto(MasterRequest masterRequest) {
        return objectMapper.convertValue(masterRequest.getData(), CountryCurrencyDto.class);
    }

    @Override
    public MasterWorkFlowDto mapToMasterWorkFlowDto(CountryCurrencyDto dto, WorkflowOperation workflowOperation, String remark) {
        return MasterWorkFlowDto.builder().masterCode(MasterType.COUNTRY_CURRENCY).action(workflowOperation).remark(remark).entityId(dto.getId().toString()).build();
    }

    @Override
    public void validate(CountryCurrencyDto dto, WorkflowOperation workflowOperation) {
        switch (workflowOperation) {
            case CREATE ->countryCurrencyValidator.validateCreate(dto);
            case UPDATE ->countryCurrencyValidator.validateUpdate(dto);
            default -> new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, workflowOperation.name()));
        }
    }

    @Override
    public void validateBulkMasters(List<CountryCurrencyDto> masters, List<String> workflowActions, String performAction) {
        countryCurrencyValidator.validateBulkMaster(masters, workflowActions, performAction);
    }

    @Override
    public CountryCurrencyDto save(CountryCurrencyDto dto, WorkflowOperation action) {
        dto.setStatus(WorkflowAction.INACTIVE.name());
        dto.setAction(WorkflowAction.PENDING_FOR_APPROVAL.name());
        switch (action) {
            case CREATE -> {
                return countryCurrencyDao.create(dto);
            }
            case UPDATE -> {
                return countryCurrencyDao.update(dto);
            }
        }
        throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, action.name()));
    }

    @Override
    public void performAction(List<UUID> ids, WorkflowOperation action) {
        switch (action) {
            case APPROVE ->countryCurrencyDao.performAction(ids, WorkflowAction.APPROVED);
            case REJECT -> countryCurrencyDao.performAction(ids, WorkflowAction.PENDING_FOR_REJECTED);
            case INACTIVE ->countryCurrencyDao.performAction(ids, WorkflowAction.PENDING_FOR_INACTIVE);
            default -> new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ENUM_ERROR_MESSAGE, action.name()));
        }
    }

    @Override
    public List<CountryCurrencyDto> findByIds(List<UUID> ids) {
        return countryCurrencyDao.findAllById(ids);
    }


    @Override
    public Page<CountryCurrencyDto> search(MasterSearchRequest request, Pageable pageable) {
        Specification<CountryCurrency> specification = MasterSpecification.buildCountryCurrency(request.getFilters());
        return countryCurrencyDao.findBySpecfication(specification, pageable);
    }

    @Override
    public AdminPortalResponse<Map<String, Object>> mapToResponse(List<CountryCurrencyDto> dtos, Long total) {
        List<Map<String, Object>> masterResponse = dtos.stream().<Map<String, Object>>map(countryCurrencyDto -> objectMapper.convertValue(countryCurrencyDto, new TypeReference<>() {
        })).collect(Collectors.toList());
        return AdminPortalResponse.<Map<String, Object>>builder().status(SUCCESS_RESPONSE_CODE).data(masterResponse).count((long) dtos.size()).total(total).build();
    }

}


@Component
@RequiredArgsConstructor
public class CountryCurrencyDao {
    private final MasterMapper<CountryCurrencyDto, CountryCurrency> masterMapper;
    private final CountryCurrencyRepository countryCurrencyRepository;

    public CountryCurrencyDto create(CountryCurrencyDto countryCurrencyDto) {
        CountryCurrency entity = countryCurrencyRepository.save(masterMapper.mapDtoToEntity(countryCurrencyDto));
        return masterMapper.mapEntityToDto(entity);
    }

    public CountryCurrencyDto update(CountryCurrencyDto dto) {
        CountryCurrency entity = countryCurrencyRepository.findById(dto.getId()).orElseThrow(() -> new AdminPortalException(FAILED_ERROR_CODE, MessageFormat.format(FAILED_ERROR_MESSAGE_WITH_REASON, "CountryCurrency update", "CountryCurrency record not found for the masterId")));
        masterMapper.updateEntityByDto(dto, entity);
        CountryCurrency updatedCountryCurrency = countryCurrencyRepository.save(entity);
        return masterMapper.mapEntityToDto(updatedCountryCurrency);
    }

    public List<CountryCurrencyDto> findAllById(List<UUID> ids) {
        return countryCurrencyRepository.findAllById(ids).stream().map(masterMapper::mapEntityToDto).toList();
    }


    public void performAction(List<UUID>ids, WorkflowAction action){
        switch(action){
            case APPROVED ->countryCurrencyRepository.approve(ids, WorkflowAction.APPROVED.name());
            case PENDING_FOR_REJECTED -> countryCurrencyRepository.performAction(ids, WorkflowAction.PENDING_FOR_REJECTED.name());
            case PENDING_FOR_INACTIVE -> countryCurrencyRepository.performAction(ids, WorkflowAction.PENDING_FOR_INACTIVE.name());
        }
    }

    public Page<CountryCurrencyDto> findBySpecfication(Specification<CountryCurrency> specification, Pageable pageable) {
        Page<CountryCurrency> page = countryCurrencyRepository.findAll(specification, pageable);
        return page.map(masterMapper::mapEntityToDto);
    }
}


public interface CountryCurrencyRepository extends JpaRepository<CountryCurrency, UUID> , JpaSpecificationExecutor<CountryCurrency> {

    @Transactional
    @Modifying
    @Query("""
           UPDATE CountryCurrency c SET c.action = :action,
            c.status = CASE
                WHEN c.action='PENDING_FOR_APPROVAL' THEN 'ACTIVE'
                WHEN c.action='PENDING_FOR_REJECTED' THEN 'INACTIVE'
                WHEN c.action='PENDING_FOR_INACTIVE' THEN 'INACTIVE'
                ELSE 'INACTIVE'
            END
            WHERE c.id IN :ids
           """)
    int approve(@Param("ids") List<UUID> ids, String action);


    @Transactional
    @Modifying
    @Query("""
           UPDATE CountryCurrency c SET c.action = :action WHERE c.id IN :ids
           """)
    int performAction(@Param("ids") List<UUID> ids, String action);

}


@Service
@RequiredArgsConstructor
public class MasterBulkUploadService {

    private final MasterBulkUploadConfigRepository configRepository;
    private final MasterBulkUploadFileRepository fileRepository;
    private final MasterBulkUploadFileDetailRepository fileDetailRepository;
    private final MasterBulkUploadHandlerFactory handlerFactory;
    private final ObjectMapper objectMapper;
    private final FileService fileService;

    public AdminPortalResponse<MasterBulkUploadResponse> upload(String masterCode, MultipartFile file) {
        validateFile(file);
        MasterType masterType = MasterType.getMasterType(masterCode);
        MasterBulkUploadConfig config = configRepository.findByMasterTypeIgnoreCase(masterType.getCode())
                .orElseThrow(() -> new AdminPortalException(ErrorConstants.NOT_FOUND_ERROR_CODE, MessageFormat.format(ErrorConstants.NOT_FOUND_ERROR_MESSAGE, "Bulk upload config for " + masterType.getCode())));

        if (config.getBulkUploadAllowed() == null || config.getBulkUploadAllowed() != 1) {
            throw new ValidationException(ErrorConstants.INVALID_ERROR_CODE, "Bulk upload is not allowed for masterType: " + masterType.getCode());
        }

        BulkUploadFormatConfig formatConfig = parseConfig(config.getFileFormatConfig());
        MasterBulkUploadHandler handler = handlerFactory.getHandler(masterType);

        MasterBulkUploadFile uploadFile = new MasterBulkUploadFile();
        uploadFile.setMasterType(masterType.getCode());
        uploadFile.setMasterConfig(config);
        uploadFile.setFileName(file.getOriginalFilename());
        uploadFile.setSourceFileS3Path(fileService.uploadFile(file));
        uploadFile.setParsingStatus(BulkUploadParsingStatus.IN_PROGRESS.name());
        uploadFile.setFileStatus(BulkUploadFileStatus.IN_PROGRESS.name());
        uploadFile.setRemark("File parsing is in progress.");
        uploadFile.setTotalRecords(0L);
        uploadFile.setSuccessRecords(0L);
        uploadFile.setFailedRecords(0L);
        uploadFile = fileRepository.save(uploadFile);

        try {
            List<Map<String, String>> records = readRecords(file, formatConfig);
            List<MasterBulkUploadFileDetail> detailEntities = new ArrayList<>();
            List<Map<String, String>> failedRecords = new ArrayList<>();
            long success = 0;
            long failed = 0;

            for (Map<String, String> record : records) {
                BulkUploadRowResult rowResult;
                try {
                    rowResult = handler.process(BulkUploadRecordContext.builder()
                            .masterType(masterType)
                            .record(record)
                            .formatConfig(formatConfig)
                            .build());
                } catch (ValidationException ex) {
                    rowResult = BulkUploadRowResult.builder()
                            .recordStatus(BulkUploadRecordStatus.FAILED.name())
                            .remark(ex.getErrorMessage())
                            .build();
                } catch (AdminPortalException ex) {
                    rowResult = BulkUploadRowResult.builder()
                            .recordStatus(BulkUploadRecordStatus.FAILED.name())
                            .remark(ex.getErrorMessage())
                            .build();
                }

                if (BulkUploadRecordStatus.SUCCESS.name().equals(rowResult.getRecordStatus())) {
                    success++;
                } else {
                    failed++;
                    failedRecords.add(buildFailedRecord(record, rowResult.getRemark()));
                }
                detailEntities.add(mapDetail(uploadFile, record, rowResult));
            }

            fileDetailRepository.saveAll(detailEntities);
            uploadFile.setFailedRecordFileS3Path(uploadFailedRecordsFile(formatConfig, failedRecords));
            uploadFile.setTotalRecords((long) records.size());
            uploadFile.setSuccessRecords(success);
            uploadFile.setFailedRecords(failed);
            uploadFile.setParsingStatus(BulkUploadParsingStatus.COMPLETED.name());
            uploadFile.setFileStatus(failed > 0 ? BulkUploadFileStatus.COMPLETED_WITH_ERRORS.name() : BulkUploadFileStatus.COMPLETED.name());
            uploadFile.setRemark(buildFileRemark(success, failed));
            fileRepository.save(uploadFile);
            return response(uploadFile);
        } catch (RuntimeException ex) {
            uploadFile.setParsingStatus(BulkUploadParsingStatus.FAILED.name());
            uploadFile.setFileStatus(BulkUploadFileStatus.FAILED.name());
            uploadFile.setRemark(resolveMessage(ex));
            fileRepository.save(uploadFile);
            throw ex;
        }
    }

    private List<Map<String, String>> readRecords(MultipartFile file, BulkUploadFormatConfig formatConfig) {
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(file.getInputStream(), StandardCharsets.UTF_8))) {
            List<String> nonBlankLines = reader.lines()
                    .map(String::trim)
                    .filter(StringUtils::isNotBlank)
                    .toList();

            if (nonBlankLines.isEmpty()) {
                throw new ValidationException(ErrorConstants.MANDATORY_ERROR_CODE, "Bulk upload file is empty.");
            }

            List<String> headers = parseCsvLine(nonBlankLines.getFirst());
            validateHeaders(headers, formatConfig.getHeaders());

            List<Map<String, String>> records = new ArrayList<>();
            for (int i = 1; i < nonBlankLines.size(); i++) {
                List<String> values = parseCsvLine(nonBlankLines.get(i));
                if (values.stream().allMatch(StringUtils::isBlank)) {
                    continue;
                }
                Map<String, String> row = new LinkedHashMap<>();
                for (int index = 0; index < headers.size(); index++) {
                    row.put(headers.get(index), index < values.size() ? values.get(index).trim() : null);
                }
                records.add(row);
            }
            return records;
        } catch (IOException e) {
            throw new AdminPortalException(ErrorConstants.GENERIC_ERROR_CODE, ErrorConstants.GENERIC_ERROR_MESSAGE);
        }
    }

    private List<String> parseCsvLine(String line) {
        return java.util.Arrays.stream(line.split(",", -1))
                .map(String::trim)
                .toList();
    }

    private void validateHeaders(List<String> actualHeaders, List<String> expectedHeaders) {
        if (actualHeaders.size() != expectedHeaders.size()) {
            throw new ValidationException(ErrorConstants.INVALID_ERROR_CODE, "Invalid headers in bulk upload file.");
        }
        for (int i = 0; i < expectedHeaders.size(); i++) {
            if (!expectedHeaders.get(i).equalsIgnoreCase(actualHeaders.get(i))) {
                throw new ValidationException(ErrorConstants.INVALID_ERROR_CODE, "Invalid headers in bulk upload file.");
            }
        }
    }

    private MasterBulkUploadFileDetail mapDetail(MasterBulkUploadFile uploadFile, Map<String, String> record, BulkUploadRowResult rowResult) {
        MasterBulkUploadFileDetail detail = new MasterBulkUploadFileDetail();
        detail.setMasterUploadFile(uploadFile);
        detail.setRecordJson(toJson(record));
        detail.setStatus(rowResult.getRecordStatus());
        detail.setOperation(rowResult.getOperation());
        detail.setRemark(rowResult.getRemark());
        detail.setMasterRecordId(rowResult.getMasterRecordId());
        return detail;
    }

    private BulkUploadFormatConfig parseConfig(String config) {
        try {
            return objectMapper.readValue(config, BulkUploadFormatConfig.class);
        } catch (JsonProcessingException e) {
            throw new AdminPortalException(ErrorConstants.JSON_ERROR_CODE, MessageFormat.format(ErrorConstants.JSON_ERROR_MESSAGE, "bulk upload format config"));
        }
    }

    private String toJson(Map<String, String> record) {
        try {
            return objectMapper.writeValueAsString(record);
        } catch (JsonProcessingException e) {
            throw new AdminPortalException(ErrorConstants.JSON_ERROR_CODE, MessageFormat.format(ErrorConstants.JSON_ERROR_MESSAGE, "bulk upload detail"));
        }
    }

    private void validateFile(MultipartFile file) {
        if (file == null || file.isEmpty()) {
            throw new ValidationException(ErrorConstants.MANDATORY_ERROR_CODE, "Bulk upload file is required.");
        }
        String fileName = file.getOriginalFilename();
        if (StringUtils.isBlank(fileName) || !fileName.toLowerCase().endsWith(".csv")) {
            throw new ValidationException(ErrorConstants.INVALID_ERROR_CODE, "Only csv file format is allowed.");
        }
    }

    private String buildFileRemark(long success, long failed) {
        return "Bulk upload processed. Success records: " + success + ", Failed records: " + failed;
    }

    private Map<String, String> buildFailedRecord(Map<String, String> record, String remark) {
        Map<String, String> failedRecord = new LinkedHashMap<>(record);
        failedRecord.put("failureRemark", StringUtils.defaultString(remark));
        return failedRecord;
    }

    private String uploadFailedRecordsFile(BulkUploadFormatConfig formatConfig, List<Map<String, String>> failedRecords) {
        if (failedRecords.isEmpty()) {
            return null;
        }
        Path tempFile = null;
        try {
            tempFile = Files.createTempFile("master-bulk-upload-failed-", ".csv");
            try (BufferedWriter writer = Files.newBufferedWriter(tempFile, StandardCharsets.UTF_8)) {
                List<String> headers = new ArrayList<>(formatConfig.getHeaders());
                headers.add("failureRemark");
                writer.write(toCsvRow(headers));
                writer.newLine();
                for (Map<String, String> failedRecord : failedRecords) {
                    List<String> values = headers.stream().map(header -> failedRecord.getOrDefault(header, "")).toList();
                    writer.write(toCsvRow(values));
                    writer.newLine();
                }
            }
            return fileService.uploadFile(tempFile.toFile());
        } catch (IOException e) {
            throw new AdminPortalException(ErrorConstants.GENERIC_ERROR_CODE, ErrorConstants.GENERIC_ERROR_MESSAGE);
        } finally {
            if (tempFile != null) {
                try {
                    Files.deleteIfExists(tempFile);
                } catch (IOException ignored) {
                }
            }
        }
    }

    private String toCsvRow(List<String> values) {
        return values.stream()
                .map(this::escapeCsvValue)
                .reduce((left, right) -> left + "," + right)
                .orElse("");
    }

    private String escapeCsvValue(String value) {
        String safeValue = StringUtils.defaultString(value);
        if (safeValue.contains(",") || safeValue.contains("\"") || safeValue.contains("\n") || safeValue.contains("\r")) {
            return "\"" + safeValue.replace("\"", "\"\"") + "\"";
        }
        return safeValue;
    }

    private String resolveMessage(RuntimeException ex) {
        if (ex instanceof ValidationException validationException) {
            return validationException.getErrorMessage();
        }
        if (ex instanceof AdminPortalException adminPortalException) {
            return adminPortalException.getErrorMessage();
        }
        return ex.getMessage();
    }

    private AdminPortalResponse<MasterBulkUploadResponse> response(MasterBulkUploadFile uploadFile) {
        MasterBulkUploadResponse data = MasterBulkUploadResponse.builder().uploadFileId(uploadFile.getId()).masterType(uploadFile.getMasterType()).sourceFileS3Path(uploadFile.getSourceFileS3Path()).failedRecordFileS3Path(uploadFile.getFailedRecordFileS3Path()).totalRecords(uploadFile.getTotalRecords()).successRecords(uploadFile.getSuccessRecords()).failedRecords(uploadFile.getFailedRecords()).parsingStatus(uploadFile.getParsingStatus()).fileStatus(uploadFile.getFileStatus()).remark(uploadFile.getRemark()).build();
        return AdminPortalResponse.<MasterBulkUploadResponse>builder().status(SUCCESS_RESPONSE_CODE).data(List.of(data)).count(1L).total(1L).build();
    }
}

@Service("countryCurrencyBulkUploadHandler")
@RequiredArgsConstructor
public class CountryCurrencyBulkUploadHandler implements MasterBulkUploadHandler {

    private static final String STATUS = "status";
    private static final String ACTIVE = "ACTIVE";
    private static final String INACTIVE = "INACTIVE";
    private static final String APPROVED = "APPROVED";
    private static final String RECORD_ALREADY_EXISTS = "Record already exists.";
    private static final String NO_VALID_RECORDS = "No valid records found to inactivate.";
    private static final String RECORD_ALREADY_INACTIVE = "Record is already Inactive.";

    private final CountryCurrencyService countryCurrencyService;
    private final CountryCurrencyRepository countryCurrencyRepository;
    private final MasterWorkFlowService masterWorkFlowService;

    @Override
    public MasterType getMasterType() {
        return MasterType.COUNTRY_CURRENCY;
    }

    @Override
    public BulkUploadRowResult process(BulkUploadRecordContext context) {
        Map<String, String> record = context.getRecord();
        CountryCurrencyDto dto = toDto(record);
        String status = normalize(record.get(STATUS));

        if (StringUtils.isBlank(status) || ACTIVE.equals(status)) {
            return handleCreate(dto);
        }
        if (INACTIVE.equals(status)) {
            return handleInactivate(dto);
        }
        return failure("Unsupported status value: " + record.get(STATUS));
    }

    private BulkUploadRowResult handleCreate(CountryCurrencyDto dto) {
        countryCurrencyService.validate(dto, WorkflowOperation.CREATE);
        if (findExact(dto).isPresent()) {
            return failure(RECORD_ALREADY_EXISTS);
        }
        CountryCurrencyDto savedDto = countryCurrencyService.save(dto, WorkflowOperation.CREATE);
        MasterWorkFlowDto workFlowDto = countryCurrencyService.mapToMasterWorkFlowDto(savedDto, WorkflowOperation.CREATE, "CREATE action perform successfully.");
        masterWorkFlowService.save(workFlowDto);
        return BulkUploadRowResult.builder()
                .recordStatus(BulkUploadRecordStatus.SUCCESS.name())
                .operation(WorkflowOperation.CREATE.name())
                .remark("Record moved to Approval Pending.")
                .masterRecordId(savedDto.getId())
                .build();
    }

    private BulkUploadRowResult handleInactivate(CountryCurrencyDto dto) {
        Optional<CountryCurrency> activeRecord = countryCurrencyRepository
                .findByCodeIgnoreCaseAndNameIgnoreCaseAndCurrencyCodeIgnoreCaseAndCurrencyNameIgnoreCaseAndStatusAndAction(
                        dto.getCode(), dto.getName(), dto.getCurrencyCode(), dto.getCurrencyName(), ACTIVE, APPROVED);
        if (activeRecord.isPresent()) {
            countryCurrencyService.performAction(java.util.List.of(activeRecord.get().getId()), WorkflowOperation.INACTIVE);
            MasterWorkFlowDto workFlowDto = countryCurrencyService.mapToMasterWorkFlowDto(
                    countryCurrencyService.findByIds(java.util.List.of(activeRecord.get().getId())).getFirst(),
                    WorkflowOperation.INACTIVE,
                    "INACTIVE action perform successfully.");
            masterWorkFlowService.save(workFlowDto);
            return BulkUploadRowResult.builder()
                    .recordStatus(BulkUploadRecordStatus.SUCCESS.name())
                    .operation(WorkflowOperation.INACTIVE.name())
                    .remark("Record moved to Inactivation pending.")
                    .masterRecordId(activeRecord.get().getId())
                    .build();
        }

        boolean inactiveRecordExists = countryCurrencyRepository
                .findByCodeIgnoreCaseAndNameIgnoreCaseAndCurrencyCodeIgnoreCaseAndCurrencyNameIgnoreCaseAndStatus(
                        dto.getCode(), dto.getName(), dto.getCurrencyCode(), dto.getCurrencyName(), INACTIVE)
                .isPresent();

        return inactiveRecordExists ? failure(RECORD_ALREADY_INACTIVE) : failure(NO_VALID_RECORDS);
    }

    private Optional<CountryCurrency> findExact(CountryCurrencyDto dto) {
        return countryCurrencyRepository.findByCodeIgnoreCaseAndNameIgnoreCaseAndCurrencyCodeIgnoreCaseAndCurrencyNameIgnoreCase(
                dto.getCode(), dto.getName(), dto.getCurrencyCode(), dto.getCurrencyName());
    }

    private CountryCurrencyDto toDto(Map<String, String> record) {
        CountryCurrencyDto dto = new CountryCurrencyDto();
        dto.setCode(normalize(record.get("code")));
        dto.setName(normalize(record.get("name")));
        dto.setCurrencyCode(normalize(record.get("currencyCode")));
        dto.setCurrencyName(normalize(record.get("currencyName")));
        return dto;
    }

    private String normalize(String value) {
        return value == null ? null : value.trim();
    }

    private BulkUploadRowResult failure(String remark) {
        return BulkUploadRowResult.builder()
                .recordStatus(BulkUploadRecordStatus.FAILED.name())
                .remark(remark)
                .build();
    }
}


@RestController
@RequestMapping("/api/merchant")
public class MeCodeMappingController {

    private final MeCodeMappingService service;

    public MeCodeMappingController(MeCodeMappingService service) {
        this.service = service;
    }

    @GetMapping("/me-code-mapping")
    public MeCodeMappingResponse fetch(@RequestParam("mId") String mId) {
        return service.fetch(mId);
    }
}




















@Service
@RequiredArgsConstructor
public class MasterWorkFlowService {
    private final LoggerUtility log = LoggerFactoryUtility.getLogger(this.getClass());

    private final MasterWorkFlowRepository masterWorkFlowRepository;
    private final MasterWorkFlowMapper masterWorkFlowMapper;

    public void save(MasterWorkFlowDto masterWorkFlowDto) {
        MasterWorkFlow masterWorkFlow = masterWorkFlowMapper.mapEntityToDto(masterWorkFlowDto);
        masterWorkFlowRepository.save(masterWorkFlow);
    }

    public void save(List<MasterWorkFlowDto> masterWorkFlowDtos) {
        List<MasterWorkFlow> masterWorkFlows = masterWorkFlowDtos.stream().map(masterWorkFlowMapper::mapEntityToDto).toList();
        masterWorkFlowRepository.saveAll(masterWorkFlows);
    }

    public void update(MasterWorkFlowDto masterWorkFlowDto, BaseMasterDto oldMasterDto, BaseMasterDto newMasterDto) {
        masterWorkFlowDto.setOldValue(toJson(oldMasterDto));
        masterWorkFlowDto.setNewValue(toJson(newMasterDto));
        MasterWorkFlow masterWorkFlow = masterWorkFlowMapper.mapEntityToDto(masterWorkFlowDto);
        masterWorkFlowRepository.save(masterWorkFlow);
    }
}



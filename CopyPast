    private final OnboardingStageDao onboardingStageDao;
    private final OnboardingStageService onboardingStageService;
    private final UpiUtil upiUtil;
    private final AdminPortalLogDao adminPortalLogDao;
    private final MeCodeGenerationDao meCodeGenerationDao;
    //TODO: need to remove once test code reverted.
    private static  final SecureRandom RANDOM = new SecureRandom();
public AdminPortalResponse<UPIMECodeResponse> generateUPIMECode(UPIMECodeRequest upimeCodeRequest){
        logger.info("Validating UPI MECode request.");
        // Validate client Request.
        payModeMappingValidator.validateMeCodeRequest(upimeCodeRequest);
        // Map request based on sub merchant UPI request.
        UpiMeCodeGenerationRequest generationRequest= buildUpiMeCodeRequest(upimeCodeRequest);
        //Encrypt prepared request.
        String encryptedUpiRequest= upiUtil.configurePgpEncRequest(String.valueOf(generationRequest),upimeCodeRequest.getPgMerchantId());
        //Save request for audit purpose.
        AdminPortalAPILog portalAPILog= adminPortalLogDao.saveRequest(encryptedUpiRequest,String.valueOf(generationRequest), upimeCodeRequest.getExternalMid());
        //call external service to generate MECode.
        UpiAccesTokenResponseDto upiAccesTokenResponseDto= getUpiAccessToken(upimeCodeRequest.getExternalMid());
        UpiGenericResponse upiGenericResponse= meCodeGenerationDao.initiateUpiPostRequest(encryptedUpiRequest,upiAccesTokenResponseDto);
        String decryptedResponse= upiUtil.configurePgpDecryptRequest(upiGenericResponse.getResponseMsg(),upimeCodeRequest.getPgMerchantId());
        //save response for audit purpose
        UpiMeCodeGenerationResponse upiResponse= AdminPortalUtil.convertStringToObject(decryptedResponse,UpiMeCodeGenerationResponse.class);
        // Decrypt external response.
        adminPortalLogDao.updateAPILog(portalAPILog,upiGenericResponse,upiResponse);
        //Map decrypted response to actual response and send back to client
        UPIMECodeResponse upimeCodeResponse = UPIMECodeResponse.builder().mId(upimeCodeRequest.getPgMerchantId()).bhiQrMECode(upiResponse.getPspReferenceno()).build();
        return AdminPortalResponse.<UPIMECodeResponse>builder().data(List.of(upimeCodeResponse)).status(1).build();
    }

    private UpiMeCodeGenerationRequest buildUpiMeCodeRequest(UPIMECodeRequest upimeCodeRequest) {
        UpiMeCodeGenerationRequest upiRequest = new UpiMeCodeGenerationRequest();
        upiRequest.setPspReferenceno("SBI" + generateRandomNumber());
        upiRequest.setPgMerchantId(upimeCodeRequest.getPgMerchantId());
        upiRequest.setMebussname(upimeCodeRequest.getMerchantName());
        upiRequest.setIntegrationType(upimeCodeRequest.getIntegrationType());
        upiRequest.setPanNo(upimeCodeRequest.getPanNumber());

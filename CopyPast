private AdminPortalResponse<String> performAction(
        MasterApproveRejectRequest request,
        WorkflowOperation operation,
        List<String> allowedPreviousActions,
        String masterCode) {

    BaseMasterService<BaseMasterDto> masterService = resolveMasterService(masterCode);

    List<UUID> ids = request.getRecords()
            .stream()
            .map(record -> UUID.fromString(record.getMasterId()))
            .toList();

    List<BaseMasterDto> masters = masterService.findByIds(ids);

    masterService.validateBulkMasters(
            masters,
            allowedPreviousActions,
            operation.name());

    logger.info("Request validated successfully for operation : {}.", operation.name());

    masterService.performAction(ids, operation);

    logger.info("{} operation performed successfully for master code: {}",
            operation.name(),
            masterCode);

    Map<UUID, String> remarksMap = request.getRecords()
            .stream()
            .collect(Collectors.toMap(
                    record -> UUID.fromString(record.getMasterId()),
                    RecordItem::getRemark
            ));

    List<MasterWorkFlowDto> workflowDtos = masters.stream()
            .map(master -> {

                String remark = remarksMap.get(master.getId());

                if (StringUtils.isBlank(remark)) {
                    remark = MessageFormat.format(message, operation.name());
                }

                return masterService.mapToMasterWorkFlowDto(
                        master,
                        operation,
                        remark);
            })
            .toList();

    masterWorkFlowService.save(workflowDtos);

    logger.info("Master workflow records saved for {}", masterCode);

    return mapToResponse(MessageFormat.format(message, operation.name()));
}



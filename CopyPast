@Component
@RequiredArgsConstructor
public class MerchantCurrencyDao {
    private final MerchantCurrencyRepository merchantCurrencyRepository;

    public MerchantCurrencyDto saveOnboardingCurrencies(MerchantCurrencyDto merchantCurrencyDto, String mId) {
        List<MerchantCurrency> entities=  merchantCurrencyDto.getCurrencyDtos().stream().map(dto-> MerchantCurrency.builder().mId(mId).currencyCode(dto.getCurrencyCode()).status(Y.equalsIgnoreCase(dto.getIsActive())? ACTIVE : INACTIVE).build()).toList();
        List<MerchantCurrency> merchantCurrencyList= merchantCurrencyRepository.saveAll(entities);
        return MerchantCurrencyDto.builder().mId(mId).currencyDtos(merchantCurrencyList.stream().map(currency -> CurrencyDto.builder().currencyCode(currency.getCurrencyCode()).isActive(currency.getStatus()).build()).collect(Collectors.toList())).build();
    }

    /**
     * @param mId String
     * @param currencyCode String
     * @return boolean
     */
    public boolean isCurrencyCodeAvailable(String mId, String currencyCode){
        return merchantCurrencyRepository.existsByMIdAndCurrencyCode(mId, currencyCode);
    }

    public List<MerchantCurrency> getCurrencyCodesByMid(String mId){
        return merchantCurrencyRepository.findByMId(mId);
    }

}


        upiRequest.setAwlmcc(upimeCodeRequest.getMccCode());
        upiRequest.setSettleType(upimeCodeRequest.getPaymentSettlementType());
        upiRequest.setMerVirtualAdd(upimeCodeRequest.getVpaAddress());
        upiRequest.setRequestUrl1(upimeCodeRequest.getWhiteListedUrl());
        upiRequest.setExtMID(upimeCodeRequest.getExternalMid());
        upiRequest.setExtTID(upimeCodeRequest.getExternalTid());
        upiRequest.setGstn(upimeCodeRequest.getMerchantGstIn());
        upiRequest.setMerchantType(upimeCodeRequest.getTypeOfMerchant());
        upiRequest.setMerGenre(upimeCodeRequest.getMerchantGenre());
        upiRequest.setOnboardingType(upimeCodeRequest.getOnboardingType());
        upiRequest.setMeWhitelist("Y");
        upiRequest.setMerConcentFlag("N");
        upiRequest.setSplitTag(84);
        upiRequest.setTxnValidation("1|2|3");
//        upiRequest.setFeatureNotSupported();
        return upiRequest;

    }


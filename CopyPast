@Data
@RequiredArgsConstructor
@RestController
@RequestMapping("/payModeMapping")
public class PayModeMappingController {
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final PayModeMappingService payModeService;

//    @PreAuthorize("hasAnyRole('BIZ_SUPPORT')")
    @PostMapping("/meCodeMapping/{mId}")
    @Operation(summary = "Get ME code details for merchant id for maker and checker")
    public AdminPortalResponse<String> submitMECodeMapping(@PathVariable("mId") String mId, @RequestBody List<MeCodeMappingRequest> meCodeMappingRequests){

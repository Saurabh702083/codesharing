   /**
     * @param fromDateEpochMilli Long
     * @return List of OnboardingResponse
     */
    public List<OnboardingResponse> getListOfMerchant(Long fromDateEpochMilli) {
        // 1. Create an Instant from UTC milliseconds
        Instant instant = Instant.ofEpochMilli(fromDateEpochMilli);
        // 2. Convert the Instant to ZonedDateTime in IST as ePay 1.0 has time in IST
        ZonedDateTime zonedDateTimeIst = instant.atZone(ZoneId.of("Asia/Kolkata"));
        // 3. Extract the LocalDateTime
        LocalDateTime fromDate = zonedDateTimeIst.toLocalDateTime();

        logger.info("Getting list of new merchant from date: {}", fromDate);
        // 1. Fetch data efficiently
        List<Merchant> merchantList = merchantRepository.getLatestAndUpdatedMerchants(fromDate);

        // If the initial list is empty, return early
        if (merchantList.isEmpty()) {
            return List.of();
        }

        // 2. Extract MIDs
        List<String> mIds = merchantList.stream().map(Merchant::getMId).toList();

        // 3. Fetch related users efficiently in a single batch call
        List<MerchantUserView> users = merchantUserViewRepository.findBymIdInAndUserType(mIds, "SUPERUSER");

        // 4. Convert the list of users into a Map<MId, MerchantUserView>
        // Handles potential duplicates by keeping the existing entry if conflict occurs (though ideally MId should be unique for SUPERUSER)
        Map<String, MerchantUserView> userLookupMap = users.stream()
                .collect(Collectors.toMap(MerchantUserView::getMId, user -> user, (existing, replacement) -> existing));

        // 5. Fetch related bank accounts
        var bankAccounts = onboardBankAccountRepository.findAllByMerchantId(mIds);
        Map<String, List<MerchantOnboardBankAccountView>> accLookupMap = bankAccounts.stream()
                .collect(Collectors.groupingBy(acc -> acc.getMerchantAccountStatus().getMerchantId()));

        // 6. Fetch MEKs and KEKs for given mId
        var keys = merchantOnboardKeyManagementRepository.findAllByMerchantId(mIds);
        Map<String, MerchantOnboardKeyManagementView> keyMap = keys.stream()
                .collect(Collectors.toMap(MerchantOnboardKeyManagementView::getMId, key -> key, (existing, replacement) -> existing));

        // 7. Build responses
        return merchantList.stream()
            .map(merchant ->
                OnboardingResponse.builder()
                        .merchant(merchantMapper.toMerchantDto(merchant))
                        .user(merchantMapper.toUserDto(userLookupMap.get(merchant.getMId())))
                        .bankAccounts(merchantMapper.toOnBoardAccounts(accLookupMap.get(merchant.getMId())))
                        .onboardingKey(merchantMapper.toOnboardKey(keyMap.get(merchant.getMId())))
                        .build()
            )
            .toList();
    }



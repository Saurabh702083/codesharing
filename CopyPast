@Service
@RequiredArgsConstructor
public class PaymodeMappingService {
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MerchantValidator merchantValidator;
    private final PaymodeMappingDao paymodeMappingDao;
    private final MeCodeMappingMapper mapper;

    /**
     * This th
     * @param mId String
     * @return MeCodeMappingResponse
     */
    public AdminPortalResponse<MeCodeMappingResponse> getMECodeDetails(String mId) {
        logger.info("Validating mId: {}", mId);
        merchantValidator.validateMid(mId);
        //TODO check previous step is completed or not.
        logger.info("Fetching paygateway mapping details saved for mId: {}", mId);
        Map<Long, MerchantPaygatewayMapping> merchantGatewayMappings = paymodeMappingDao.fetchSavedMerchantPaygateway(mId)
                .stream().collect(Collectors.toMap(MerchantPaygatewayMapping::getGatewayId, Function.identity(), (existing, duplicate) -> existing));
        logger.info("Fetching all paygateway master details.");
        List<MeCodeMappingProjection> masterMappings = paymodeMappingDao.findMeCodeMappingByMerchantId(mId);
        logger.info("Building me code mapping response for mId : {}",mId);
        MeCodeMappingResponse response = buildResponse(mId, masterMappings, merchantGatewayMappings);
        return AdminPortalResponse.<MeCodeMappingResponse>builder().data(List.of(response)).status(SUCCESS_RESPONSE_CODE).build();
    }


    private MeCodeMappingResponse buildResponse(String mId, List<MeCodeMappingProjection> mappings, Map<Long, MerchantPaygatewayMapping> merchantGatewayMappings) {
        Map<String, List<MeCodeMappingProjection>> mappingsByCurrency = mappings.stream().collect(Collectors.groupingBy(
                                MeCodeMappingProjection::getCurrencyCombCode, LinkedHashMap::new, Collectors.toList()));

        List<CurrencyComboDto> currencyCombos = mappingsByCurrency.entrySet().stream()
                        .map(entry -> buildCurrencyCombo(entry.getKey(), entry.getValue(), merchantGatewayMappings)).toList();
        return MeCodeMappingResponse.builder().mId(mId).currencyCombos(currencyCombos).build();
    }

    private CurrencyComboDto buildCurrencyCombo(String currencyCombCode, List<MeCodeMappingProjection> mappings, Map<Long, MerchantPaygatewayMapping> merchantGatewayMappings) {
        Map<String, List<MeCodeMappingProjection>> mappingsByPaymode = mappings.stream().collect(Collectors.groupingBy(
                                MeCodeMappingProjection::getPaymodeCode, LinkedHashMap::new, Collectors.toList()));

        List<PaymodeDto> paymodes = mappingsByPaymode.entrySet().stream()
                        .map(entry -> buildPaymode(entry.getValue(), merchantGatewayMappings)).toList();
        return new CurrencyComboDto(currencyCombCode, paymodes);
    }

    private PaymodeDto buildPaymode(List<MeCodeMappingProjection> mappings, Map<Long, MerchantPaygatewayMapping> merchantGatewayMappings) {
        MeCodeMappingProjection firstRow = mappings.getFirst();
        PaymodeDto paymode = mapper.toPaymodeDto(firstRow);
        List<GatewayDto> gateways = mappings.stream().map(mapping -> buildGateway(mapping, merchantGatewayMappings)).toList();
        paymode.setGateways(gateways);
        return paymode;
    }

    private GatewayDto buildGateway(MeCodeMappingProjection mapping, Map<Long, MerchantPaygatewayMapping> merchantGatewayMappings) {
        GatewayDto gateway = mapper.toGatewayDto(mapping);
        MerchantPaygatewayMapping merchantMapping = merchantGatewayMappings.get(mapping.getGatewayId());
        if (ObjectUtils.isNotEmpty(merchantMapping)) {
            mapper.updateGatewayDto(merchantMapping, gateway);
        }
        return gateway;
    }

}



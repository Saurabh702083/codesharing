package com.epay.admin.portal.specification;

import com.epay.admin.portal.entity.admin.VwUserRoleList;
import com.epay.admin.portal.enums.AuthStatus;
import com.epay.admin.portal.model.request.AdminUserListRequest;
import org.apache.commons.lang3.StringUtils;
import org.springframework.data.jpa.domain.Specification;

import java.util.Set;
import java.util.UUID;

import static com.epay.admin.portal.util.AdminPortalConstants.LIKE_ALL_STRING_FORMATTER;

public class UserRoleListSpecification {

    private UserRoleListSpecification() {}

    /**
     * @param roleCodes  roles the caller may see for this list (already validated)
     * @param groupId    non-null only for group admins -> restricts to their own group
     * @param active     parsed status filter (null = no filter)
     * @param authStatus parsed auth status filter (null = no filter)
     */
    public static Specification<VwUserRoleList> searchUserRoles(AdminUserListRequest request, Set<String> roleCodes,
                                                                UUID groupId, Boolean active, AuthStatus authStatus) {
        return Specification.where(isPrimaryRole())
                .and(hasRoleCodeIn(roleCodes))
                .and(hasGroupId(groupId))
                .and(hasGroupName(request.getGroupName()))
                .and(likeIgnoreCase("adId", request.getAdId()))
                .and(likeIgnoreCase("fullName", request.getName()))
                .and(likeIgnoreCase("emailId", request.getEmailId()))
                .and(likeIgnoreCase("designation", request.getDesignation()))
                .and(hasActive(active))
                .and(hasAuthStatus(authStatus))
                .and(hasFrom(request.getFrom()))
                .and(hasTo(request.getTo()));
    }

    /** Secondary role assignments have their own screens, so list primary roles only. */
    public static Specification<VwUserRoleList> isPrimaryRole() {
        return (root, query, cb) -> cb.isTrue(root.<Boolean>get("isPrimary"));
    }

    public static Specification<VwUserRoleList> hasRoleCodeIn(Set<String> roleCodes) {
        return (root, query, cb) -> roleCodes == null || roleCodes.isEmpty()
                ? cb.disjunction()                      // nothing allowed -> nothing returned
                : root.get("roleCode").in(roleCodes);
    }

    public static Specification<VwUserRoleList> hasGroupId(UUID groupId) {
        return (root, query, cb) -> groupId == null ? cb.conjunction()
                : cb.equal(root.get("groupId"), groupId);
    }

    public static Specification<VwUserRoleList> hasGroupName(String groupName) {
        return (root, query, cb) -> StringUtils.isBlank(groupName) ? cb.conjunction()
                : cb.equal(cb.lower(root.<String>get("groupName")), groupName.trim().toLowerCase());
    }

    public static Specification<VwUserRoleList> hasActive(Boolean active) {
        return (root, query, cb) -> active == null ? cb.conjunction()
                : cb.equal(root.<Boolean>get("isActive"), active);
    }

    public static Specification<VwUserRoleList> hasAuthStatus(AuthStatus authStatus) {
        return (root, query, cb) -> authStatus == null ? cb.conjunction()
                : cb.equal(root.get("authStatus"), authStatus);
    }

    public static Specification<VwUserRoleList> hasFrom(Long from) {
        return (root, query, cb) -> from == null ? cb.conjunction()
                : cb.ge(root.get("userCreatedAt"), from);
    }

    public static Specification<VwUserRoleList> hasTo(Long to) {
        return (root, query, cb) -> to == null ? cb.conjunction()
                : cb.le(root.get("userCreatedAt"), to);
    }

    private static Specification<VwUserRoleList> likeIgnoreCase(String field, String value) {
        return (root, query, cb) -> StringUtils.isBlank(value) ? cb.conjunction()
                : cb.like(cb.lower(root.<String>get(field)),
                          String.format(LIKE_ALL_STRING_FORMATTER, value.trim().toLowerCase()));
    }
}


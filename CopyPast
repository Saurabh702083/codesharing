@Service
@Data
@RequiredArgsConstructor
public class PayModeMappingService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final MerchantValidator merchantValidator;
    private final MerchantCurrencyCombinationMappingDao merchantCurrencyCombinationMappingDao;
    private final PayModeMappingDao paymodeMappingDao;
    private final MeCodeMappingMapper mapper;
    private final PayModeMappingValidator payModeMappingValidator;


    public AdminPortalResponse<String> submitMECodingMapping(String mId, List<MeCodeMappingRequest> requests) {
        merchantValidator.validateMid(mId);
        payModeMappingValidator.validateRequest(requests);
        Set<Long> gatewayIds = requests.stream().map(MeCodeMappingRequest::getPaygatewayId).collect(Collectors.toSet());
        Map<Long, PaygatewayMaster> masters = paymodeMappingDao.fetchMasterByIds(gatewayIds);
        if (masters.size() != gatewayIds.size()) {
            throw new AdminPortalException (ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ERROR_MESSAGE,PAYGATEWAY_ID,"Invalid paygatewayId in request"));
        }

        Set<Long> existingIds = requests.stream().map(MeCodeMappingRequest::getId)
                .filter(Objects::nonNull).collect(Collectors.toSet());
        Map<Long, MerchantPaygatewayMapping> existing = paymodeMappingDao.fetchSavedByIds(existingIds, mId);
        if (existing.size() != existingIds.size()) {
            throw new AdminPortalException(ErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(ErrorConstants.INVALID_ERROR_MESSAGE,"id","Some ids not found for this merchant"));
        }

        List<MerchantPaygatewayMapping> toSave = requests.stream().map(request -> {
            MerchantPaygatewayMapping paygatewayMapping;
            if (ObjectUtils.isNotEmpty(request.getId())) {
                paygatewayMapping = existing.get(request.getId());
                mapper.updateEntity(request, paygatewayMapping);
            } else {
                paygatewayMapping = mapper.toEntity(request);
                paygatewayMapping.setMerchantId(mId);
            }
            paygatewayMapping.setPaygatewayId(request.getPaygatewayId());
            paygatewayMapping.setAggregatorCode(masters.get(request.getPaygatewayId()).getAggregatorCode());
            paygatewayMapping.setAuthStatus(PENDING);
            paygatewayMapping.setIsTpvActive("N");
            return paygatewayMapping;
        }).toList();

        paymodeMappingDao.saveAll(toSave);
        return AdminPortalResponse.<String>builder().data(List.of("Submitted successfully")).status(SUCCESS_RESPONSE_CODE).build();


    }
}



@Component
@RequiredArgsConstructor
public class PayModeMappingValidator extends BaseValidator{
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    public void validateRequest(List<MeCodeMappingRequest> requests) {
        errorDtoList = new ArrayList<>();
        logger.info("Validating MeCodeMappingRequest.");
        for (MeCodeMappingRequest codeMappingRequest : requests) {
            checkMandatoryField(codeMappingRequest.getPaygatewayId(), PAYGATEWAY_ID);
            checkMandatoryField(codeMappingRequest.getMeCode(), ME_CODE);
            checkMandatoryField(codeMappingRequest.getIsActive(), IS_ACTIVE);
            throwIfErrors();
        }

        for (MeCodeMappingRequest codeMappingRequest : requests) {
            checkForLeadingTrailingAndSingleSpace(codeMappingRequest.getVpa(), VPA);
            checkForLeadingTrailingAndSingleSpace(codeMappingRequest.getMeCode(), ME_CODE);
            checkForLeadingTrailingAndSingleSpace(codeMappingRequest.getIsActive(), IS_ACTIVE);
            checkForLeadingTrailingAndSingleSpace(codeMappingRequest.getTimerWindows(), TIMER_WINDOW);
            checkForLeadingTrailingAndSingleSpace(codeMappingRequest.getMakerComment(), MAKER_COMMENT);
            throwIfErrors();
        }

        for (MeCodeMappingRequest meCodeMappingRequest : requests) {
            validateFieldLength(meCodeMappingRequest.getVpa(), 100, VPA);
            validateFieldLength(meCodeMappingRequest.getMeCode(), 100, ME_CODE);
            validateFieldLength(meCodeMappingRequest.getIsActive(), 1, IS_ACTIVE);
            validateFieldLength(meCodeMappingRequest.getTimerWindows(), 100, TIMER_WINDOW);
            validateFieldLength(meCodeMappingRequest.getMakerComment(), 250, MAKER_COMMENT);
            throwIfErrors();
        }

    }

}

@Component
@RequiredArgsConstructor
public class PayModeMappingDao {
    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final PaygatewayMasterRepository paygatewayMasterRepository;
    private final MerchantPaygatewayMappingRepository mappingRepository;

    public List<MeCodeMappingProjection> findMeCodeMappingByMerchantId(String mId){
        return paygatewayMasterRepository.findMeCodeMappingByMerchantId(mId);
    }

    public List<MerchantPaygatewayMapping> fetchSavedMerchantPaygateway(String mId){
        return mappingRepository.findByMerchantId(mId);
    }

    public Map<Long, PaygatewayMaster> fetchMasterByIds(Collection<Long> ids) {
        return paygatewayMasterRepository.findAllById(ids).stream()
                .collect(Collectors.toMap(PaygatewayMaster::getId, Function.identity()));
    }

    public Map<Long, MerchantPaygatewayMapping> fetchSavedByIds(Collection<Long> ids, String mId) {
        if (ids.isEmpty()) return Map.of();
        return mappingRepository.findByIdInAndMerchantId(ids, mId).stream()
                .collect(Collectors.toMap(MerchantPaygatewayMapping::getId, Function.identity()));
    }

    public void saveAll(List<MerchantPaygatewayMapping> entities) {
        mappingRepository.saveAll(entities);
    }
}




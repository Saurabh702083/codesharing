public class UpiServiceClient extends ApiClient {
    final static LoggerUtility logger = LoggerFactoryUtility.getLogger(UpiServiceClient.class);
    private final ObjectMapper objectMapper;


    @Value("${security.cors.origin}")
    private String corsOrigin;

    public UpiServiceClient(String baseUrl, ObjectMapper objectMapper, String corsOrigin) {
        super(baseUrl, corsOrigin);
        this.objectMapper = objectMapper;
    }



    public  <T> T initiateUpiAccessToken(String url, String requestPayload, Class<T> responseDto) {
        return getWebClient().post()
                .uri(url)
                .header("Content-Type", MediaType.APPLICATION_FORM_URLENCODED_VALUE)
                .header("Accept", MediaType.APPLICATION_JSON_VALUE)
                .header(HttpHeaders.ORIGIN, corsOrigin)
                .bodyValue(requestPayload)
                .retrieve()
                .onStatus(
                        httpStatus -> httpStatus.is4xxClientError() || httpStatus.is5xxServerError(),
                        clientResponse -> clientResponse.bodyToMono(String.class).flatMap(errorBody -> {
                            logger.error("EIS Service call failed with status: {}, error body: {}", clientResponse.statusCode().value(), errorBody);
                            return Mono.error(new AdminPortalException(
                                    EXTERNAL_SERVICE_ERROR_CODE,
                                    MessageFormat.format(EXTERNAL_SERVICE_ERROR_MESSAGE, "UPI Service")
                            ));
                        })
                )
                .bodyToMono(responseDto)
                .block();
    }


    public  <T> T initiateUpiRequest(String url, String encryptedUpiRequest, UpiAccesTokenResponseDto upiAccesTokenResponseDto, Class<T> responseDto) {
        return getWebClient().post()
                .uri(url)
                .header("Content-Type", MediaType.APPLICATION_FORM_URLENCODED_VALUE)
                .header("Accept", MediaType.APPLICATION_JSON_VALUE)
                .header(HttpHeaders.ORIGIN, corsOrigin)
                .header(HttpHeaders.AUTHORIZATION, "Bearer "+upiAccesTokenResponseDto)
                .bodyValue(encryptedUpiRequest)
                .retrieve()
                .onStatus(
                        httpStatus -> httpStatus.is4xxClientError() || httpStatus.is5xxServerError(),
                        clientResponse -> clientResponse.bodyToMono(String.class).flatMap(errorBody -> {
                            logger.error("EIS Service call failed with status: {}, error body: {}", clientResponse.statusCode().value(), errorBody);
                            return Mono.error(new AdminPortalException(
                                    EXTERNAL_SERVICE_ERROR_CODE,
                                    MessageFormat.format(EXTERNAL_SERVICE_ERROR_MESSAGE, "UPI Service")
                            ));
                        })
                )
                .bodyToMono(responseDto)
                .block();
    }
}


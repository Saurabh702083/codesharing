-- =====================================================================
-- VW_USER_ROLE_LIST
-- One row per USER_ROLE (user x role), enriched with user, role and group.
-- Plain (non-materialized) view on purpose: approval screens need
-- real-time AUTH_STATUS, a materialized view would show stale data.
-- =====================================================================
CREATE OR REPLACE VIEW VW_USER_ROLE_LIST AS
SELECT
    ur.ID                                           AS USER_ROLE_ID,   -- PK of the view
    u.ID                                            AS USER_ID,
    u.AGGREGATOR_ID                                 AS AGGREGATOR_ID,

    -- user details
    u.ADID                                          AS ADID,
    u.FIRST_NAME                                    AS FIRST_NAME,
    u.LAST_NAME                                     AS LAST_NAME,
    TRIM(u.FIRST_NAME || ' ' || u.LAST_NAME)        AS FULL_NAME,
    u.EMAIL_ID                                      AS EMAIL_ID,
    u.PHONE_NUMBER                                  AS PHONE_NUMBER,
    u.DESIGNATION                                   AS DESIGNATION,
    u.USER_TYPE                                     AS USER_TYPE,
    u.STATUS                                        AS USER_STATUS,
    u.CREATED_AT                                    AS USER_CREATED_AT,
    u.CREATED_BY                                    AS CREATED_BY,

    -- user_role details (Status / Auth Status shown on the screens come from here)
    ur.IS_PRIMARY                                   AS IS_PRIMARY,
    ur.IS_ACTIVE                                    AS IS_ACTIVE,
    ur.AUTH_STATUS                                  AS AUTH_STATUS,
    ur.RECORD_STATUS                                AS RECORD_STATUS,
    ur.CREATED_AT                                   AS ROLE_CREATED_AT,

    -- role details
    br.ID                                           AS ROLE_ID,
    br.BR_CODE                                      AS ROLE_CODE,
    br.NAME                                         AS ROLE_NAME,

    -- group details
    bg.ID                                           AS GROUP_ID,
    bg.BG_CODE                                      AS GROUP_CODE,
    bg.NAME                                         AS GROUP_NAME
FROM USER_ROLE ur
         JOIN USERS u                    ON u.ID  = ur.USER_ID
         JOIN BUSINESS_ROLES_MASTER br   ON br.ID = ur.ROLE_ID
         LEFT JOIN BUSINESS_GROUP_MASTER bg ON bg.ID = br.BUSINESS_GROUP_ID
WHERE (u.DELETED_AT  IS NULL OR u.DELETED_AT  = 0)
  AND (ur.DELETED_AT IS NULL OR ur.DELETED_AT = 0);

-- Optional: indexes on base tables that the filters will hit (check what you already have)
-- CREATE INDEX IDX_USER_ROLE_USER_ID   ON USER_ROLE (USER_ID);
-- CREATE INDEX IDX_USER_ROLE_ROLE_ID   ON USER_ROLE (ROLE_ID);
-- CREATE INDEX IDX_USER_ROLE_PRIM_AUTH ON USER_ROLE (IS_PRIMARY, AUTH_STATUS);
-- CREATE INDEX IDX_USERS_ADID          ON USERS (ADID);


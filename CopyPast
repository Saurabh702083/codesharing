@RequiredArgsConstructor
public class PayModeMappingService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private final MerchantCurrencyCombinationMappingDao merchantCurrencyCombinationMappingDao;
    private final PayModeMappingDao paymodeMappingDao;
    private final MeCodeMappingMapper mapper;

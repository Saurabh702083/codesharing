public AdminPortalResponse<String> submitMECodingMapping(
        String mId,
        List<MeCodeMappingRequest> requests) {

    merchantValidator.validateMid(mId);

    // All request and database-related validations
    payModeMappingValidator.validateRequest(mId, requests);

    // Fetch again because the validator returns void
    Set<Long> gatewayIds = requests.stream()
            .map(MeCodeMappingRequest::getPaygatewayId)
            .collect(Collectors.toSet());

    Map<Long, PaygatewayMaster> masters =
            paymodeMappingDao.fetchMasterByIds(gatewayIds);

    Set<Long> existingIds = requests.stream()
            .map(MeCodeMappingRequest::getId)
            .filter(Objects::nonNull)
            .collect(Collectors.toSet());

    Map<Long, MerchantPaygatewayMapping> existing =
            paymodeMappingDao.fetchSavedByIds(existingIds, mId);

    List<MerchantPaygatewayMapping> toSave = requests.stream()
            .map(request -> {
                MerchantPaygatewayMapping entity;

                if (request.getId() != null) {
                    entity = existing.get(request.getId());
                    mapper.updateEntity(request, entity);
                } else {
                    entity = mapper.toEntity(request);
                    entity.setMerchantId(mId);
                }

                entity.setPaygatewayId(request.getPaygatewayId());
                entity.setAggregatorCode(
                        masters.get(request.getPaygatewayId()).getAggregatorCode());
                entity.setAuthStatus(PENDING);
                entity.setIsTpvActive("N");

                return entity;
            })
            .toList();

    paymodeMappingDao.saveAll(toSave);

    return AdminPortalResponse.<String>builder()
            .data(List.of("Submitted successfully"))
            .status(SUCCESS_RESPONSE_CODE)
            .build();
}


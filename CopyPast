@Data
@AllArgsConstructor
@RequiredArgsConstructor
@JsonInclude(JsonInclude.Include.NON_NULL)
public class OnboardingRequest implements Serializable {
    @Valid
    @NotNull(message = HIBERNATOR_MANDATORY_ERROR_MESSAGE)
    private MerchantDto merchant;
    @Valid
    @NotNull(message = HIBERNATOR_MANDATORY_ERROR_MESSAGE)
    private MerchantUserDto user;
    private List<MerchantOnboardBankAccountDto> bankAccounts;
    private OnboardingKeyDto onboardingKeyDto;
    private MerchantCurrencyDto merchantCurrencyDto;
}


package com.epay.admin.portal.util.enums;

import lombok.Getter;
import lombok.RequiredArgsConstructor;

@Getter
@RequiredArgsConstructor
public enum AccountType {
    CREDIT(PaymentInstrument.RCC, "05", "CREDIT"),
    CREDITLINE(PaymentInstrument.CL, "031", "CREDITLINE"),
    PPIWALLET(PaymentInstrument.PPI, "06", "PPIWALLET");

    private final PaymentInstrument instrument;
    private final String accTypeVal;
    private final String accType;
}





public final class VpaTypeConstants {
    public static final String SELF = "SELF";
    public static final String BHIMQR = "BHIMQR";
    private VpaTypeConstants() {}
}




private List<FeatureNotSupported> buildFeatureNotSupported(PayProc payProc) {

    // No payProc or SELF -> empty list
    if (payProc == null || !VpaTypeConstants.BHIMQR.equalsIgnoreCase(payProc.getVpaType())) {
        return Collections.emptyList();
    }

    // Instruments received in request (None / null / empty = nothing supported)
    Set<PaymentInstrument> supported = CollectionUtils.isEmpty(payProc.getPaymentInstruments())
            ? Collections.emptySet()
            : EnumSet.copyOf(payProc.getPaymentInstruments());

    // Anything NOT in the request goes to featureNotSupported
    return Arrays.stream(AccountType.values())
            .filter(type -> !supported.contains(type.getInstrument()))
            .map(type -> FeatureNotSupported.builder()
                    .accTypeVal(type.getAccTypeVal())
                    .accType(type.getAccType())
                    .build())
            .collect(Collectors.toList());
}



public UpiMeCodeGenerationRequest toGenerationRequest(UPIMECodeRequest request) {
    return UpiMeCodeGenerationRequest.builder()
            // ... other field mappings
            .featureNotSupported(buildFeatureNotSupported(request.getPayProc()))
            .build();
}
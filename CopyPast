import sbi.mer.pgp.dto.PGPDto;
import sbi.mer.pgp.main.PGPEncDecUtility;

import java.io.File;

@Data
@Configuration
public class UpiUtil {
    private final AdminPortalConfig adminPortalConfig;
    private final String globalPath = "certs/";
    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    public String configurePgpEncRequest(String plainPayload, String pgMerchantId) {
        try {
            PGPDto pgpRequest = new PGPDto();
            pgpRequest.setPayload(plainPayload);
            pgpRequest.setPgMerchantId(pgMerchantId);
            pgpRequest.setPrivateKeyPass(adminPortalConfig.getUpiPvtKeyPwd());
            pgpRequest.setPrivateKeyPath(getFilePath(globalPath + adminPortalConfig.getUpiPrivateKeyPath()));
            pgpRequest.setPublicKeyPath(getFilePath(globalPath + adminPortalConfig.getUpiPublicKeyPath()));

            String encryptedVpaValidationReqData = PGPEncDecUtility.getPGPEncryptedPayload(pgpRequest);
            UpiGenericRequest genericRequest= UpiGenericRequest.builder().requestMsg(encryptedVpaValidationReqData).pgMerchantId(pgMerchantId).build();
            return String.valueOf(genericRequest);
        } catch (Exception e) {
            logger.error("Error While Encrypt PGP request {} {}", e.getCause(), e.getMessage());
            throw new AdminPortalException("", "Error during PGP Encryption" + e.getMessage());
        }
    }

    public String configurePgpDecryptRequest(String encPayload, String pgMerchantId) {
        try {
            PGPDto pgpRequest = new PGPDto();
            pgpRequest.setPayload(encPayload);
            pgpRequest.setPgMerchantId(pgMerchantId);
            pgpRequest.setPrivateKeyPass(adminPortalConfig.getUpiPvtKeyPwd());
            pgpRequest.setPrivateKeyPath(getFilePath(globalPath + adminPortalConfig.getUpiPrivateKeyPath()));
            pgpRequest.setPublicKeyPath(getFilePath(globalPath + adminPortalConfig.getUpiPublicKeyPath()));

            logger.info("configurePgpDecryptRequest() ::   pgp dto ::  {} ", pgpRequest);
            String decryptedUpiResponse = PGPEncDecUtility.getPGPDecryptedPayload(pgpRequest);
            return decryptedUpiResponse;
        } catch (Exception e) {
            logger.error("Error While Decryption PGP request {} {}", e.getCause(), e.getMessage());
            throw new AdminPortalException("", "Error while PGP decryption" + e.getMessage());
        }
    }

    private String getFilePath(String path) {
        logger.info("getFilePath() :: cert file path:  {} ", path);
        File file = new File(path);
        if (!file.isFile())
            throw new AdminPortalException("00000", "Cert location file not found");

        String absolutePath = file.getAbsolutePath();
        logger.info("getFilePath() :: cert absolutePath:  {} ", absolutePath);
        return absolutePath;
    }

}


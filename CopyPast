public MerchantChangeCompareResponse getChangeCompareDetails(String mifId) {
    var business = diffUtil.compare(businessInfoDao.getBusinessInfo(mifId),
                                    businessInfoDao.getPendingBusinessInfo(mifId));
    var contact  = diffUtil.compare(contactInfoDao.getContactInfo(mifId),
                                    contactInfoDao.getPendingContactInfo(mifId));
    var website  = diffUtil.compare(websiteInfoDao.getWebsiteInfo(mifId),
                                    websiteInfoDao.getPendingWebsiteInfo(mifId));
    var bankTxn  = diffUtil.compare(bankTxnInfoDao.getBankTxnInfo(mifId),
                                    bankTxnInfoDao.getPendingBankTxnInfo(mifId));
    var bankAcc  = diffUtil.compare(bankAccountInfoDao.getBankAccountInfo(mifId),
                                    bankAccountInfoDao.getPendingBankAccountInfo(mifId));
    var tif      = diffUtil.compare(tifInfoDao.getTifInfo(mifId),
                                    tifInfoDao.getPendingTifInfo(mifId));
    var vscc     = diffUtil.compare(vsccDao.getVSCCInfo(mifId),
                                    vsccDao.getPendingVSCCInfo(mifId));

    boolean any = Stream.of(business, contact, website, bankTxn, bankAcc, tif, vscc)
                        .anyMatch(ChangeCompareDto::isChanged);

    return MerchantChangeCompareResponse.builder()
        .merchantMIFId(mifId).hasPendingChange(any)
        .businessDto(business).contactDto(contact).websiteDto(website)
        .bankTxnDto(bankTxn).bankAccountInfoDto(bankAcc)
        .tifDto(tif).vsccDto(vscc)
        .documentDto(documentDao.getDocumentInfo(mifId))
        .build();
}




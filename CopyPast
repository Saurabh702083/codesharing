package com.epay.admin.portal.util;

import com.epay.admin.portal.enums.SystemRole;
import com.epay.admin.portal.enums.UserListType;
import com.epay.admin.portal.exception.AdminPortalException;
import org.apache.commons.lang3.StringUtils;

import java.util.*;
import java.util.stream.Collectors;

import static com.epay.admin.portal.enums.SystemRole.*;
import static com.epay.admin.portal.util.AdminPortalConstants.ROLE_HIERARCHY;   // adjust to where your map lives

/**
 * Decides which roles a logged-in admin may see in the user list.
 *   MASTER_ADMIN      -> SUPER_ADMIN + the group admins only
 *   SUPER_ADMIN       -> group admins + every role below them
 *   <GROUP>_ADMIN     -> roles below that group admin (own group only)
 * Built from ROLE_HIERARCHY so new roles only need to be added there.
 */
public final class UserListAccessPolicy {

    // move these two to your ErrorConstants
    public static final String ACCESS_DENIED_ERROR_CODE = "ADMIN_ACCESS_DENIED";
    public static final String ACCESS_DENIED_ERROR_MESSAGE = "You are not allowed to view this list";

    public static final Set<SystemRole> GROUP_ADMIN_ROLES =
            Collections.unmodifiableSet(EnumSet.of(BIZ_GROUP_ADMIN, BANK_IT_GROUP_ADMIN, OPS_ITDCR_GROUP_ADMIN, CMD_GROUP_ADMIN));

    /** caller role -> roles the caller is allowed to search */
    public static final Map<SystemRole, Set<SystemRole>> SEARCH_SCOPE;

    static {
        Map<SystemRole, Set<SystemRole>> scope = new EnumMap<>(SystemRole.class);

        Set<SystemRole> master = EnumSet.of(SUPER_ADMIN);
        master.addAll(GROUP_ADMIN_ROLES);
        scope.put(MASTER_ADMIN, Collections.unmodifiableSet(master));

        scope.put(SUPER_ADMIN, Collections.unmodifiableSet(descendants(SUPER_ADMIN)));
        GROUP_ADMIN_ROLES.forEach(r -> scope.put(r, Collections.unmodifiableSet(descendants(r))));

        SEARCH_SCOPE = Collections.unmodifiableMap(scope);
    }

    private UserListAccessPolicy() {}

    /** All roles reachable from root through ROLE_HIERARCHY (cycle safe, e.g. BIZ_SUPPORT -> BIZ_SUPPORT). */
    private static Set<SystemRole> descendants(SystemRole root) {
        Set<SystemRole> result = EnumSet.noneOf(SystemRole.class);
        Deque<SystemRole> queue = new ArrayDeque<>(List.of(root));
        while (!queue.isEmpty()) {
            SystemRole current = queue.poll();
            for (SystemRole child : ROLE_HIERARCHY.getOrDefault(current, Set.of())) {
                if (result.add(child)) {
                    queue.add(child);
                }
            }
        }
        return result;
    }

    /** Null-safe lookup (SystemRole.fromValue throws on unknown values, tokens may carry other roles). */
    public static Optional<SystemRole> toSystemRole(String value) {
        return Arrays.stream(SystemRole.values())
                .filter(r -> r.getValue().equalsIgnoreCase(value))
                .findFirst();
    }

    /** First role in the token that is allowed to use the list API. */
    public static SystemRole resolveCallerRole(List<String> tokenRoles) {
        return Optional.ofNullable(tokenRoles).orElse(List.of()).stream()
                .map(UserListAccessPolicy::toSystemRole)
                .flatMap(Optional::stream)
                .filter(SEARCH_SCOPE::containsKey)
                .findFirst()
                .orElseThrow(() -> new AdminPortalException(ACCESS_DENIED_ERROR_CODE, ACCESS_DENIED_ERROR_MESSAGE));
    }

    /**
     * Role codes to filter the view on = (roles of the requested list type) ∩ (roles the caller may see),
     * optionally narrowed by the "Role" dropdown.
     */
    public static Set<String> resolveRoleCodes(SystemRole caller, UserListType listType, String requestedRoleCode) {
        Set<SystemRole> allowed = SEARCH_SCOPE.getOrDefault(caller, Set.of());

        Set<SystemRole> forType = new HashSet<>(switch (listType) {
            case SUPER_ADMIN -> Set.of(SUPER_ADMIN);
            case GROUP_ADMIN -> GROUP_ADMIN_ROLES;
            case ROLE_USER -> allowed.stream()
                    .filter(r -> r != SUPER_ADMIN && !GROUP_ADMIN_ROLES.contains(r))
                    .collect(Collectors.toSet());
        });
        forType.retainAll(allowed);

        if (forType.isEmpty()) {
            throw new AdminPortalException(ACCESS_DENIED_ERROR_CODE, ACCESS_DENIED_ERROR_MESSAGE);
        }
        if (StringUtils.isNotBlank(requestedRoleCode)) {
            SystemRole requested = SystemRole.fromValue(requestedRoleCode);
            if (!forType.contains(requested)) {
                throw new AdminPortalException(ACCESS_DENIED_ERROR_CODE, ACCESS_DENIED_ERROR_MESSAGE);
            }
            return Set.of(requested.getValue());
        }
        return forType.stream().map(SystemRole::getValue).collect(Collectors.toSet());
    }
}

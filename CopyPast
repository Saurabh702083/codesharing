@Component
@RequiredArgsConstructor
public class MerchantCurrencyDao {

    private final MerchantCurrencyRepository merchantCurrencyRepository;
    private final MerchantMapper mapper; // or wherever mapCurrencyDtosToEntities lives

    public List<MerchantCurrencyDto> saveOnboardingCurrencies(MerchantCurrencyDto merchantCurrencyDto, String mId) {
        List<MerchantCurrency> entities = mapper.mapCurrencyDtosToEntities(merchantCurrencyDto.getCurrencyDtos(), mId);
        List<MerchantCurrency> saved = merchantCurrencyRepository.saveAll(entities);
        // return however you want the response shaped - example below returns the same DTO back
        return List.of(MerchantCurrencyDto.builder()
                .mId(mId)
                .currencyDtos(saved.stream()
                        .map(e -> CurrencyDto.builder()
                                .currencyCode(e.getCurrencyCode())
                                .status(e.getStatus())
                                .build())
                        .collect(Collectors.toList()))
                .build());
    }
}



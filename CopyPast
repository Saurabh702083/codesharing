
package com.epay.admin.portal.config;

import com.epay.admin.portal.exceptions.UpiIntegrationError;
import com.epay.admin.portal.exceptions.UpiIntegrationException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Configuration;
import sbi.mer.pgp.dto.PGPDto;
import sbi.mer.pgp.main.PGPEncDecUtility;

import java.io.File;

@Slf4j
@Configuration
@RequiredArgsConstructor
public class UpiUtil {

    private final AdminPortalConfig adminPortalConfig;

    private static final String CERTIFICATE_DIRECTORY = "certs/";

    public String configurePgpEncRequest(
            String plainPayload,
            String pgMerchantId,
            String correlationId) {

        try {
            PGPDto request = createPgpDto(plainPayload, pgMerchantId);

            String encrypted =
                    PGPEncDecUtility.getPGPEncryptedPayload(request);

            if (encrypted == null || encrypted.isBlank()) {
                throw new IllegalStateException(
                        "PGP encryption returned an empty payload"
                );
            }

            log.info(
                    "UPI request encryption successful | correlationId={}",
                    correlationId
            );

            return encrypted;

        } catch (Exception ex) {
            log.error(
                    "UPI request encryption failed | correlationId={} " +
                    "| errorType={}",
                    correlationId,
                    ex.getClass().getSimpleName(),
                    ex
            );

            throw new UpiIntegrationException(
                    UpiIntegrationError.PGP_ENCRYPTION_FAILED,
                    "UPI request encryption failed",
                    null,
                    ex
            );
        }
    }

    public String configurePgpDecryptRequest(
            String encryptedPayload,
            String pgMerchantId,
            String correlationId) {

        try {
            if (encryptedPayload == null || encryptedPayload.isBlank()) {
                throw new IllegalArgumentException(
                        "Encrypted response is empty"
                );
            }

            PGPDto request = createPgpDto(
                    encryptedPayload, pgMerchantId
            );

            String decrypted =
                    PGPEncDecUtility.getPGPDecryptedPayload(request);

            if (decrypted == null || decrypted.isBlank()) {
                throw new IllegalStateException(
                        "PGP decryption returned an empty payload"
                );
            }

            log.info(
                    "UPI response decryption successful | correlationId={}",
                    correlationId
            );

            return decrypted;

        } catch (Exception ex) {
            log.error(
                    "UPI response decryption failed | correlationId={} " +
                    "| errorType={}",
                    correlationId,
                    ex.getClass().getSimpleName(),
                    ex
            );

            throw new UpiIntegrationException(
                    UpiIntegrationError.PGP_DECRYPTION_FAILED,
                    "UPI response decryption failed",
                    null,
                    ex
            );
        }
    }

    private PGPDto createPgpDto(
            String payload,
            String pgMerchantId) {

        PGPDto request = new PGPDto();
        request.setPayload(payload);
        request.setPgMerchantId(pgMerchantId);
        request.setPrivateKeyPass(adminPortalConfig.getUpiPvtKeyPwd());
        request.setPrivateKeyPath(
                getFilePath(
                        CERTIFICATE_DIRECTORY
                                + adminPortalConfig.getUpiPrivateKeyPath()
                )
        );
        request.setPublicKeyPath(
                getFilePath(
                        CERTIFICATE_DIRECTORY
                                + adminPortalConfig.getUpiPublicKeyPath()
                )
        );

        return request;
    }

    private String getFilePath(String path) {
        File file = new File(path);

        if (!file.isFile() || !file.canRead()) {
            throw new IllegalStateException(
                    "UPI certificate is missing or unreadable"
            );
        }

        return file.getAbsolutePath();
    }
}

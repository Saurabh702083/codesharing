package com.example.adminportal.group;

import jakarta.persistence.criteria.Predicate;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.util.StringUtils;

import java.util.ArrayList;
import java.util.List;

public final class BusinessGroupSpecification {

    private BusinessGroupSpecification() {}

    public static Specification<BusinessGroup> withFilter(GroupSearchRequest f) {
        return (root, query, cb) -> {
            List<Predicate> predicates = new ArrayList<>();

            if (StringUtils.hasText(f.getGroupCode())) {
                predicates.add(cb.like(cb.lower(root.get("bgCode")),
                        "%" + f.getGroupCode().trim().toLowerCase() + "%"));
            }
            if (StringUtils.hasText(f.getGroupName())) {
                predicates.add(cb.like(cb.lower(root.get("name")),
                        "%" + f.getGroupName().trim().toLowerCase() + "%"));
            }
            if (f.getStatus() != null) {
                predicates.add(cb.equal(root.get("isActive"), f.getStatus().isActive()));
            }
            if (f.getAuthStatus() != null) {
                predicates.add(cb.equal(root.get("authStatus"), f.getAuthStatus()));
            }
            return cb.and(predicates.toArray(new Predicate[0]));
        };
    }
}

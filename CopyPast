public static GroupSearchResponse from(BusinessGroup g) {
    GroupSearchResponse r = new GroupSearchResponse();
    r.setId(g.getId());
    r.setGroupCode(g.getBgCode());
    r.setGroupName(g.getName());
    r.setStatus(Boolean.TRUE.equals(g.getIsActive()) ? "Active" : "In-Active");
    r.setAuthStatus(g.getAuthStatus());   // see note below
    return r;
}
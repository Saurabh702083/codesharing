package com.example.mapping.service;

import com.example.mapping.dto.*;
import com.example.mapping.entity.MerchantPaygatewayMapping;
import com.example.mapping.mapper.MeCodeMappingMapper;
import com.example.mapping.repository.MeCodeMappingProjection;
import com.example.mapping.repository.MerchantPaygatewayMappingRepository;
import com.example.mapping.repository.PaygatewayMasterRepository;
import org.springframework.stereotype.Service;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Service
public class MeCodeMappingService {

    private final PaygatewayMasterRepository masterRepository;
    private final MerchantPaygatewayMappingRepository mappingRepository;
    private final MeCodeMappingMapper mapper;

    public MeCodeMappingService(PaygatewayMasterRepository masterRepository,
                                MerchantPaygatewayMappingRepository mappingRepository,
                                MeCodeMappingMapper mapper) {
        this.masterRepository = masterRepository;
        this.mappingRepository = mappingRepository;
        this.mapper = mapper;
    }

    public MeCodeMappingResponse fetch(String mId) {

        // DB hit 1: gateways already saved by this merchant, keyed by gatewayId
        Map<String, MerchantPaygatewayMapping> savedByGatewayId = mappingRepository
                .findByMerchantId(mId).stream()
                .collect(Collectors.toMap(
                        m -> String.valueOf(m.getGatewayId()),
                        Function.identity(),
                        (a, b) -> a));

        // DB hit 2: all gateways from master (currency combo -> paymode -> gateway)
        List<MeCodeMappingProjection> rows = masterRepository.findMeCodeMappingByMerchantId(mId);

        List<CurrencyComboDto> combos = rows.stream()
                .collect(Collectors.groupingBy(MeCodeMappingProjection::getCurrencyCombCode,
                        LinkedHashMap::new, Collectors.toList()))
                .entrySet().stream()
                .map(e -> new CurrencyComboDto(e.getKey(), toPaymodes(e.getValue(), savedByGatewayId)))
                .toList();

        return new MeCodeMappingResponse(mId, combos);
    }

    private List<PaymodeDto> toPaymodes(List<MeCodeMappingProjection> rows,
                                        Map<String, MerchantPaygatewayMapping> savedByGatewayId) {
        return rows.stream()
                .collect(Collectors.groupingBy(MeCodeMappingProjection::getPaymodeCode,
                        LinkedHashMap::new, Collectors.toList()))
                .values().stream()
                .map(paymodeRows -> {
                    PaymodeDto paymode = mapper.toPaymodeDto(paymodeRows.getFirst());
                    paymode.setGateways(paymodeRows.stream()
                            .map(row -> toGateway(row, savedByGatewayId))
                            .toList());
                    return paymode;
                })
                .toList();
    }

    private GatewayDto toGateway(MeCodeMappingProjection row,
                                 Map<String, MerchantPaygatewayMapping> savedByGatewayId) {
        GatewayDto gateway = mapper.toGatewayDto(row);
        MerchantPaygatewayMapping saved = savedByGatewayId.get(row.getGatewayId());
        if (saved != null) {
            mapper.updateGatewayDto(saved, gateway);
        }
        return gateway;
    }
}











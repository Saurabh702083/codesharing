package com.example.mapping.mapper;

import com.example.mapping.dto.GatewayDto;
import com.example.mapping.dto.PaymodeDto;
import com.example.mapping.repository.MeCodeMappingProjection;
import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.Named;

import java.util.List;

@Mapper(componentModel = "spring")
public interface MeCodeMappingMapper {

    @Mapping(target = "status", source = "meCode", qualifiedByName = "meCodeToStatus")
    GatewayDto toGatewayDto(MeCodeMappingProjection projection);

    List<GatewayDto> toGatewayDtos(List<MeCodeMappingProjection> projections);

    @Mapping(target = "gateways", ignore = true)
    PaymodeDto toPaymodeDto(MeCodeMappingProjection projection);

    @Named("meCodeToStatus")
    default String meCodeToStatus(String meCode) {
        return (meCode == null || meCode.isBlank()) ? "In-Active" : "Active";
    }
}




package com.example.mapping.service;

import com.example.mapping.dto.CurrencyComboDto;
import com.example.mapping.dto.MeCodeMappingResponse;
import com.example.mapping.dto.PaymodeDto;
import com.example.mapping.mapper.MeCodeMappingMapper;
import com.example.mapping.repository.MeCodeMappingProjection;
import com.example.mapping.repository.PaygatewayMasterRepository;
import org.springframework.stereotype.Service;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.stream.Collectors;

@Service
public class MeCodeMappingService {

    private final PaygatewayMasterRepository repository;
    private final MeCodeMappingMapper mapper;

    public MeCodeMappingService(PaygatewayMasterRepository repository,
                                MeCodeMappingMapper mapper) {
        this.repository = repository;
        this.mapper = mapper;
    }

    public MeCodeMappingResponse fetch(String mId) {
        List<MeCodeMappingProjection> rows = repository.findMeCodeMappingByMerchantId(mId);

        List<CurrencyComboDto> combos = rows.stream()
                .collect(Collectors.groupingBy(MeCodeMappingProjection::getCurrencyCombCode,
                        LinkedHashMap::new, Collectors.toList()))
                .entrySet().stream()
                .map(e -> new CurrencyComboDto(e.getKey(), toPaymodes(e.getValue())))
                .toList();

        return new MeCodeMappingResponse(mId, combos);
    }

    private List<PaymodeDto> toPaymodes(List<MeCodeMappingProjection> rows) {
        return rows.stream()
                .collect(Collectors.groupingBy(MeCodeMappingProjection::getPaymodeCode,
                        LinkedHashMap::new, Collectors.toList()))
                .values().stream()
                .map(paymodeRows -> {
                    PaymodeDto paymode = mapper.toPaymodeDto(paymodeRows.getFirst());
                    paymode.setGateways(mapper.toGatewayDtos(paymodeRows));
                    return paymode;
                })
                .toList();
    }
}





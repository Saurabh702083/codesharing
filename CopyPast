@Service
@RequiredArgsConstructor
public class PayModeMappingService {

    private final LoggerUtility logger =
            LoggerFactoryUtility.getLogger(this.getClass());

    private final MerchantValidator merchantValidator;
    private final MerchantCurrencyCombinationMappingDao
            merchantCurrencyCombinationMappingDao;
    private final PayModeMappingDao payModeMappingDao;
    private final MeCodeMappingMapper mapper;
    private final PayModeMappingValidator payModeMappingValidator;

    @Transactional
    public AdminPortalResponse<String> submitMECodingMapping(
            String mId,
            List<MeCodeMappingRequest> requests) {

        // 1. Validate merchant ID
        merchantValidator.validateMid(mId);

        // 2. Validate request fields; returns void
        payModeMappingValidator.validateRequest(requests);

        // 3. Fetch and validate gateway masters once
        Set<Long> gatewayIds = requests.stream()
                .map(MeCodeMappingRequest::getPaygatewayId)
                .collect(Collectors.toSet());

        Map<Long, PaygatewayMaster> masters =
                payModeMappingDao.fetchMasterByIds(gatewayIds);

        if (masters.size() != gatewayIds.size()) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    MessageFormat.format(
                            ErrorConstants.INVALID_ERROR_MESSAGE,
                            PAYGATEWAY_ID,
                            "Invalid paygatewayId in request"));
        }

        // 4. Fetch and validate existing mappings once
        Set<Long> existingIds = requests.stream()
                .map(MeCodeMappingRequest::getId)
                .filter(Objects::nonNull)
                .collect(Collectors.toSet());

        Map<Long, MerchantPaygatewayMapping> existing =
                payModeMappingDao.fetchSavedByIds(existingIds, mId);

        if (existing.size() != existingIds.size()) {
            throw new AdminPortalException(
                    ErrorConstants.INVALID_ERROR_CODE,
                    MessageFormat.format(
                            ErrorConstants.INVALID_ERROR_MESSAGE,
                            "id",
                            "Some ids not found for this merchant"));
        }

        // 5. Map requests to entities
        List<MerchantPaygatewayMapping> toSave = requests.stream()
                .map(request -> {

                    MerchantPaygatewayMapping entity;

                    if (request.getId() != null) {
                        // Update existing mapping
                        entity = existing.get(request.getId());
                        mapper.updateEntity(request, entity);
                    } else {
                        // Create new mapping
                        entity = mapper.toEntity(request);
                        entity.setMerchantId(mId);
                    }

                    // Set system-controlled fields
                    entity.setPaygatewayId(request.getPaygatewayId());

                    entity.setAggregatorCode(
                            masters.get(request.getPaygatewayId())
                                    .getAggregatorCode());

                    entity.setAuthStatus(PENDING);
                    entity.setIsTpvActive("N");

                    return entity;
                })
                .toList();

        // 6. Save all mappings
        payModeMappingDao.saveAll(toSave);

        logger.info(
                "ME code mapping submitted successfully for mId: {}",
                mId);

        return AdminPortalResponse.<String>builder()
                .data(List.of("Submitted successfully"))
                .status(SUCCESS_RESPONSE_CODE)
                .build();
    }
}




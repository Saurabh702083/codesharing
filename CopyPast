
private void checkChangeRequest(MerchantJourneyRequest request, OnboardingStage stage) {

    if (!OnboardingStage.RISK_SCORE_APPROVAL.equals(stage)) {
        return;
    }

    Optional.ofNullable(
            merchantOnboardingDao.checkChangeRequest(request.getMerchantMIFId())
    ).ifPresent(changeRequest -> {

        String mifStatus = request.getMifStatus();

        if (MIFStatus.APPROVED.name().equals(mifStatus)) {
            changeRequest.setApproved(true);
            merchantOnboardingDao.updateMIFChangeRequest(
                    request.getMerchantMIFId(), changeRequest);

            updateMerchantInfoAfterApproval(request.getMerchantMIFId());

        } else if (MIFStatus.REJECTED.name().equals(mifStatus)) {
            changeRequest.setApproved(false);
            merchantOnboardingDao.updateMIFChangeRequest(
                    request.getMerchantMIFId(), changeRequest);
        }
    });
}

private void updateMerchantInfoAfterApproval(String mifId) {

    logger.info("Updating merchant journey status for MIF ID: {}", mifId);

    String mid = merchantMIFDao.isMidGenerated(mifId);

    if (StringUtils.isNotEmpty(mid)) {
        logger.info("MID: {} generated for MIF ID: {}", mid, mifId);
        merchantRegistrationDao.updateMerchantInfo(mifId, mid);
    }
}








private <T> ApproveChangeMIFFDto buildChangeRequest(
        Optional<T> pendingRecord,
        Function<String, T> activeRecordFetcher,
        Function<T, UUID> idExtractor,
        String mifId) {

    return pendingRecord.map(pending -> {

        T active = activeRecordFetcher.apply(mifId);

        return ApproveChangeMIFFDto.builder()
                .oldRequestId(active != null ? idExtractor.apply(active) : null)
                .newRequestId(idExtractor.apply(pending))
                .build();

    }).orElse(null);
}





import java.util.Optional;
import java.util.UUID;
import java.util.function.Function;









public ApproveChangeRequest checkChangeRequest(String mifId) {

    ApproveChangeMIFFDto business = buildChangeRequest(
            businessInfoDao.getPendingBusinessInfo(mifId),
            businessInfoDao::getBusinessInfo,
            BusinessDto::getId,
            mifId
    );

    ApproveChangeMIFFDto contact = buildChangeRequest(
            contactInfoDao.getPendingContactInfo(mifId),
            contactInfoDao::getContactInfo,
            ContactDto::getId,
            mifId
    );

    ApproveChangeMIFFDto website = buildChangeRequest(
            websiteInfoDao.getPendingWebsiteInfo(mifId),
            websiteInfoDao::getWebsiteInfo,
            WebsiteDto::getId,
            mifId
    );

    ApproveChangeMIFFDto bankTxn = buildChangeRequest(
            bankTxnInfoDao.getPendingTxnInfo(mifId),
            bankTxnInfoDao::getBankTxnInfo,
            BankTxnDto::getId,
            mifId
    );

    ApproveChangeMIFFDto bankAccount = buildChangeRequest(
            bankAccountInfoDao.getPendingBankAccountInfo(mifId),
            bankAccountInfoDao::getBankAccountInfo,
            BankAccountInfoDto::getId,
            mifId
    );

    ApproveChangeMIFFDto tif = buildChangeRequest(
            tifInfoDao.getPendingTifInfo(mifId),
            tifInfoDao::getTifInfo,
            TifDto::getId,
            mifId
    );

    ApproveChangeMIFFDto vscc = buildChangeRequest(
            vsccDao.getPendingVSCCInfo(mifId),
            vsccDao::getVSCCInfo,
            VsccDto::getId,
            mifId
    );

    boolean hasChanges = Stream.of(
            business, contact, website, bankTxn,
            bankAccount, tif, vscc
    ).anyMatch(Objects::nonNull);

    if (!hasChanges) {
        return null;
    }

    return ApproveChangeRequest.builder()
            .businessInfoIds(business)
            .contactInfoIds(contact)
            .websiteInfoIds(website)
            .bankTxnInfoIds(bankTxn)
            .bankAccountInfoIds(bankAccount)
            .tifInfoIds(tif)
            .vsccInfoIds(vscc)
            .build();
}



import java.util.Objects;
import java.util.stream.Stream;











private <T> void processChange(
        ApproveChangeMIFFDto ids,
        String mifId,
        String infoType,
        BiConsumer<UUID, String> rejectAction,
        TriConsumer<UUID, UUID, String> approveAction,
        boolean approved) {

    if (ids == null || ids.getNewRequestId() == null) {
        return;
    }

    logger.info("{} change request for {}", 
            approved ? APPROVED : REJECTED, infoType);

    if (approved) {
        if (ids.getOldRequestId() == null) {
            throw new AdminPortalException(
                    INVALID_ERROR_CODE,
                    "Active record not found for " + infoType
            );
        }

        approveAction.accept(
                ids.getNewRequestId(),
                ids.getOldRequestId(),
                mifId
        );
    } else {
        rejectAction.accept(ids.getNewRequestId(), mifId);
    }
}






@FunctionalInterface
public interface TriConsumer<A, B, C> {
    void accept(A a, B b, C c);
}






@Transactional
public void updateMIFChangeRequest(String mifId, ApproveChangeRequest req) {

    boolean approved = req.isApproved();

    processChange(req.getBusinessInfoIds(), mifId, "businessInfo",
            businessInfoDao::rejectChange,
            businessInfoDao::approveChange, approved);

    processChange(req.getContactInfoIds(), mifId, "contactInfo",
            contactInfoDao::rejectChange,
            contactInfoDao::approveChange, approved);

    processChange(req.getWebsiteInfoIds(), mifId, "websiteInfo",
            websiteInfoDao::rejectChange,
            websiteInfoDao::approveChange, approved);

    processChange(req.getBankTxnInfoIds(), mifId, "bankTxnInfo",
            bankTxnInfoDao::rejectChange,
            bankTxnInfoDao::approveChange, approved);

    processChange(req.getBankAccountInfoIds(), mifId, "bankAccountInfo",
            bankAccountInfoDao::rejectChange,
            bankAccountInfoDao::approveChange, approved);

    processChange(req.getTifInfoIds(), mifId, "tifInfo",
            tifInfoDao::rejectChange,
            tifInfoDao::approveChange, approved);

    processChange(req.getVsccInfoIds(), mifId, "vsccInfo",
            vsccDao::rejectChange,
            vsccDao::approveChange, approved);
}






@Modifying(clearAutomatically = true, flushAutomatically = true)
@Query("""
    UPDATE BusinessInfo b
       SET b.status = CASE
                          WHEN b.id = :newId THEN :activeStatus
                          ELSE :inactiveStatus
                      END,
           b.version = b.version + 1
     WHERE b.merchantMIFId = :mifId
       AND (
            (b.id = :newId AND b.status = :pendingStatus)
            OR
            (b.id = :oldId AND b.status = :activeStatus)
       )
    """)
int approveChange(
        @Param("newId") UUID newId,
        @Param("oldId") UUID oldId,
        @Param("mifId") String mifId,
        @Param("activeStatus") MIFStatus activeStatus,
        @Param("inactiveStatus") MIFStatus inactiveStatus,
        @Param("pendingStatus") MIFStatus pendingStatus
);

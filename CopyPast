
@Service
@RequiredArgsConstructor
@Slf4j
public class PayModeMappingService {

    private static final SecureRandom RANDOM = new SecureRandom();

    private final PayModeMappingValidator payModeMappingValidator;
    private final UpiMeCodeGenerationMapper upiMapper;
    private final UpiUtil upiUtil;
    private final MeCodeGenerationDao meCodeGenerationDao;
    private final AdminPortalLogDao adminPortalLogDao;
    private final ObjectMapper objectMapper;

    public AdminPortalResponse<UPIMECodeResponse> generateUPIMECode(
            UPIMECodeRequest request) {

        String correlationId = UUID.randomUUID().toString();
        long startNanos = System.nanoTime();

        AdminPortalAPILog auditLog = null;

        log.info(
                "UPI MECode generation started | correlationId={} | externalMid={}",
                correlationId,
                safeIdentifier(request == null ? null : request.getExternalMid())
        );

        try {
            // Step 1: Validate request
            log.info(
                    "UPI step 1/7: request validation | correlationId={}",
                    correlationId
            );

            payModeMappingValidator.validateMeCodeRequest(request);

            // Step 2: Map the request
            log.info(
                    "UPI step 2/7: mapping request | correlationId={}",
                    correlationId
            );

            UpiMeCodeGenerationRequest generationRequest =
                    upiMapper.toGenerationRequest(request);

            generationRequest.setPspReferenceno(
                    generatePspReference()
            );

            String requestJson =
                    objectMapper.writeValueAsString(generationRequest);

            log.info(
                    "UPI request mapped | correlationId={} | pspReference={}",
                    correlationId,
                    generationRequest.getPspReferenceno()
            );

            // Step 3: Encrypt the request and build the external envelope
            log.info(
                    "UPI step 3/7: encryption | correlationId={}",
                    correlationId
            );

            String encryptedPayload =
                    upiUtil.configurePgpEncRequest(
                            requestJson,
                            request.getPgMerchantId(),
                            correlationId
                    );

            UpiGenericRequest genericRequest = UpiGenericRequest.builder()
                    .requestMsg(encryptedPayload)
                    .pgMerchantId(request.getPgMerchantId())
                    .build();

            String externalRequest =
                    meCodeGenerationDao.serializeRequest(genericRequest);

            // Step 4: Save audit record
            log.info(
                    "UPI step 4/7: saving audit request | correlationId={}",
                    correlationId
            );

            auditLog = adminPortalLogDao.saveRequest(
                    externalRequest,
                    requestJson,
                    request.getExternalMid()
            );

            // Step 5: Get access token
            log.info(
                    "UPI step 5/7: requesting access token | correlationId={}",
                    correlationId
            );

            UpiAccessTokenResponseDto token =
                    meCodeGenerationDao.generateAccessToken(correlationId);

            // Step 6: Call onboarding API
            log.info(
                    "UPI step 6/7: calling onboarding API | correlationId={}",
                    correlationId
            );

            UpiGenericResponse externalResponse =
                    meCodeGenerationDao.initiateUpiPostRequest(
                            externalRequest,
                            token,
                            correlationId
                    );

            if (externalResponse == null
                    || externalResponse.getResponseMsg() == null
                    || externalResponse.getResponseMsg().isBlank()) {

                throw new UpiIntegrationException(
                        UpiIntegrationError.ONBOARDING_RESPONSE_INVALID,
                        "UPI onboarding response is empty"
                );
            }

            // Step 7: Decrypt, parse and validate the business response
            log.info(
                    "UPI step 7/7: decrypting onboarding response | correlationId={}",
                    correlationId
            );

            String decryptedResponse =
                    upiUtil.configurePgpDecryptRequest(
                            externalResponse.getResponseMsg(),
                            request.getPgMerchantId(),
                            correlationId
                    );

            UpiMeCodeGenerationResponse upiResponse =
                    objectMapper.readValue(
                            decryptedResponse,
                            UpiMeCodeGenerationResponse.class
                    );

            validateBusinessResponse(upiResponse);

            adminPortalLogDao.updateSuccess(
                    auditLog,
                    objectMapper.writeValueAsString(externalResponse),
                    decryptedResponse
            );

            UPIMECodeResponse response = UPIMECodeResponse.builder()
                    .mId(request.getPgMerchantId())
                    .bhiQrMECode(upiResponse.getPspReferenceno())
                    .build();

            log.info(
                    "UPI MECode generation completed | correlationId={} " +
                    "| statusCode={} | durationMs={}",
                    correlationId,
                    upiResponse.getStatusCode(),
                    elapsedMs(startNanos)
            );

            return AdminPortalResponse.<UPIMECodeResponse>builder()
                    .data(List.of(response))
                    .status(1)
                    .build();

        } catch (Exception ex) {

            log.error(
                    "UPI MECode generation failed | correlationId={} " +
                    "| externalMid={} | errorType={} | durationMs={}",
                    correlationId,
                    safeIdentifier(request == null
                            ? null : request.getExternalMid()),
                    ex.getClass().getSimpleName(),
                    elapsedMs(startNanos),
                    ex
            );

            if (auditLog != null) {
                try {
                    String errorCode =
                            ex instanceof UpiIntegrationException upiEx
                                    ? upiEx.getErrorCode().name()
                                    : "INTERNAL_ERROR";

                    adminPortalLogDao.updateFailure(auditLog, errorCode);

                } catch (Exception auditException) {
                    log.error(
                            "Failed to update UPI audit record | correlationId={}",
                            correlationId,
                            auditException
                    );
                }
            }

            if (ex instanceof UpiIntegrationException upiEx) {
                throw upiEx;
            }

            throw new UpiIntegrationException(
                    UpiIntegrationError.ONBOARDING_RESPONSE_INVALID,
                    "Unable to generate UPI MECode",
                    null,
                    ex
            );
        }
    }

    private String generatePspReference() {
        int number = RANDOM.nextInt(1_000_000_000);
        return "SBI" + String.format("%09d", number);
    }

    private void validateBusinessResponse(
            UpiMeCodeGenerationResponse response) {

        if (response == null) {
            throw new UpiIntegrationException(
                    UpiIntegrationError.ONBOARDING_RESPONSE_INVALID,
                    "UPI onboarding returned an invalid response"
            );
        }

        // Adjust these checks to the provider's documented success contract.
        if (response.getStatusCode() == null
                || response.getStatusCode().isBlank()) {

            throw new UpiIntegrationException(
                    UpiIntegrationError.ONBOARDING_RESPONSE_INVALID,
                    "UPI response does not contain a status code"
            );
        }

        // Do not assume a particular success code until confirmed
        // from the third-party API specification.
    }

    private long elapsedMs(long startNanos) {
        return TimeUnit.NANOSECONDS.toMillis(
                System.nanoTime() - startNanos
        );
    }

    private String safeIdentifier(String value) {
        if (value == null || value.isBlank()) {
            return "<missing>";
        }

        // Avoid exposing a full merchant identifier in general logs.
        return value.length() <= 4
                ? "****"
                : "****" + value.substring(value.length() - 4);
    }
}


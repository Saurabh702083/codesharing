private void validateAdminAssignment(UserRole userRole) {

    if (!Boolean.TRUE.equals(userRole.getIsActive())) {
        throw new AdminPortalException(
                ErrorConstants.INVALID_REQUEST_ERROR_CODE,
                "Logged-in user role is inactive"
        );
    }

    if (userRole.getAuthStatus() != AuthStatus.APPROVED) {
        throw new AdminPortalException(
                ErrorConstants.INVALID_REQUEST_ERROR_CODE,
                "Logged-in user role is not approved"
        );
    }
}
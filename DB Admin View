import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.mock.web.MockMultipartFile;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;

import java.util.List;
import java.util.UUID;

import static com.epay.admin.portal.util.AdminPortalConstants.SUCCESS_RESPONSE_CODE;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.multipart;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@ExtendWith(MockitoExtension.class)
class MasterControllerTest {

    private MockMvc mockMvc;

    @Mock
    private AdminMasterService adminMasterService;

    @BeforeEach
    void setUp() {
        mockMvc = MockMvcBuilders.standaloneSetup(new MasterController(adminMasterService)).build();
    }

    @Test
    void bulkUpload_shouldAcceptCountryCurrencyMultipartFileAndReturnUploadResponse() throws Exception {
        MockMultipartFile file = new MockMultipartFile("file", "countryCurrency.csv", "text/csv",
                "code,name,currencyCode,currencyName,status\nIN,India,INR,Rupee,ACTIVE\n".getBytes());
        MasterBulkUploadResponse uploadResponse = MasterBulkUploadResponse.builder()
                .uploadFileId(UUID.randomUUID())
                .masterType(MasterType.COUNTRY_CURRENCY.getCode())
                .totalRecords(1L)
                .successRecords(1L)
                .failedRecords(0L)
                .parsingStatus("COMPLETED")
                .fileStatus("COMPLETED")
                .build();
        AdminPortalResponse<MasterBulkUploadResponse> response = AdminPortalResponse.<MasterBulkUploadResponse>builder()
                .status(SUCCESS_RESPONSE_CODE)
                .data(List.of(uploadResponse))
                .count(1L)
                .total(1L)
                .build();

        when(adminMasterService.upload(eq(MasterType.COUNTRY_CURRENCY.getCode()), eq(file))).thenReturn(response);

        mockMvc.perform(multipart("/admin/master/bulk-upload/{masterCode}", MasterType.COUNTRY_CURRENCY.getCode()).file(file))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value(SUCCESS_RESPONSE_CODE))
                .andExpect(jsonPath("$.data[0].masterType").value(MasterType.COUNTRY_CURRENCY.getCode()))
                .andExpect(jsonPath("$.data[0].totalRecords").value(1))
                .andExpect(jsonPath("$.data[0].failedRecords").value(0));

        verify(adminMasterService).upload(MasterType.COUNTRY_CURRENCY.getCode(), file);
    }
}
